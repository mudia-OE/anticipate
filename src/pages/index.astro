
---
const stories = [
  {
    category: "PLAYER DEVELOPMENT",
    number: "01",
    title: "What Actually Predicts a Sophomore Leap?",
    description: "Which rookie-season signals tell us a player is ready to take the next step?",
    type: "RESEARCH"
  },
  {
    category: "PLAYER ANALYSIS",
    number: "02",
    title: "The Value of Doing the Little Things",
    description: "Exploring the numbers behind playmaking, rebounding, and winning possessions.",
    type: "DATA DIVE"
  },
  {
    category: "THE MODEL ROOM",
    number: "03",
    title: "Can We See a Breakout Coming?",
    description: "Building a framework to identify players whose production could rise next season.",
    type: "PROJECTION"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10110f" />
    <meta name="description" content="Anticipate explores basketball through data, research, and predictions. The future leaves clues." />
    <title>Anticipate — Basketball, Through Data</title>
    <style>
      :root {
        font-family: Arial, Helvetica, sans-serif;
        color: #f3f2eb;
        background: #10110f;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        --bg: #10110f;
        --panel: #191a17;
        --muted: #999b91;
        --line: #30312b;
        --lime: #d4ff45;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; }
      a { color: inherit; text-decoration: none; }

      .shell {
        width: min(1160px, calc(100% - 48px));
        margin: 0 auto;
      }

      header {
        height: 82px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line);
      }

      .brand {
        font-size: 23px;
        font-weight: 900;
        letter-spacing: -1.2px;
      }

      .brand span { color: var(--lime); }

      nav {
        display: flex;
        gap: 30px;
        align-items: center;
        font-size: 12px;
        color: #c2c3ba;
      }

      nav a:hover { color: var(--lime); }

      .nav-cta {
        border: 1px solid #55564d;
        padding: 11px 15px;
        color: #fff;
      }

      .eyebrow {
        font-size: 10px;
        letter-spacing: 2px;
        font-weight: 700;
        color: var(--lime);
      }

      .hero {
        padding: 92px 0 70px;
        display: grid;
        grid-template-columns: 1.1fr .9fr;
        gap: 50px;
        align-items: center;
      }

      h1 {
        font-size: clamp(54px, 7.5vw, 100px);
        line-height: .91;
        letter-spacing: -7px;
        margin: 24px 0;
        font-weight: 900;
      }

      h1 span {
        color: var(--lime);
      }

      .hero-copy {
        max-width: 430px;
        font-size: 15px;
        line-height: 1.8;
        color: #b1b2a9;
      }

      .hero-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
        flex-wrap: wrap;
      }

      .button {
        display: inline-block;
        padding: 15px 19px;
        background: var(--lime);
        color: #11120e;
        font-size: 12px;
        font-weight: 800;
      }

      .button.secondary {
        color: #f3f2eb;
        background: transparent;
        border: 1px solid #484940;
      }

      .feature-visual {
        min-height: 350px;
        position: relative;
        overflow: hidden;
        background:
          radial-gradient(ellipse at 75% 30%, #3b4521 0%, transparent 45%),
          linear-gradient(145deg, #24271d, #151612 65%);
        border: 1px solid #35372c;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .visual-top, .visual-bottom {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 9px;
        letter-spacing: 1.5px;
        color: #b4b6a8;
      }

      .court {
        position: absolute;
        width: 280px;
        height: 280px;
        border: 1px solid #69713e;
        border-radius: 50%;
        right: -30px;
        top: 52px;
        opacity: .65;
      }

      .court::before {
        content: "";
        position: absolute;
        height: 100%;
        width: 1px;
        left: 50%;
        background: #69713e;
      }

      .court::after {
        content: "";
        position: absolute;
        width: 110px;
        height: 110px;
        border: 1px solid #69713e;
        border-radius: 50%;
        left: 84px;
        top: 84px;
      }

      .big-number {
        position: relative;
        z-index: 1;
        font-size: clamp(80px, 11vw, 132px);
        letter-spacing: -10px;
        font-weight: 900;
        line-height: 1;
        color: var(--lime);
      }

      .visual-caption {
        position: relative;
        z-index: 1;
        max-width: 230px;
        font-size: 12px;
        line-height: 1.6;
        color: #d2d3c9;
      }

      .ticker {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .ticker-item {
        padding: 22px 20px;
        border-right: 1px solid var(--line);
      }

      .ticker-item:last-child { border-right: 0; }

      .ticker strong {
        display: block;
        font-size: 12px;
        margin-bottom: 7px;
      }

      .ticker span {
        color: var(--muted);
        font-size: 11px;
      }

      .section { padding: 78px 0; }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
      }

      h2 {
        font-size: clamp(30px, 4vw, 44px);
        letter-spacing: -2px;
        margin: 12px 0 0;
      }

      .section-link {
        font-size: 11px;
        color: var(--lime);
      }

      .stories {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
      }

      .story {
        padding: 24px;
        background: var(--panel);
        border: 1px solid #292a25;
        min-height: 260px;
        display: flex;
        flex-direction: column;
        transition: border-color .2s, transform .2s;
      }

      .story:hover {
        border-color: var(--lime);
        transform: translateY(-3px);
      }

      .story-top {
        display: flex;
        justify-content: space-between;
        font-size: 9px;
        letter-spacing: 1px;
        color: var(--muted);
      }

      .story h3 {
        font-size: 23px;
        line-height: 1.15;
        letter-spacing: -.7px;
        margin: 36px 0 12px;
      }

      .story p {
        color: #a6a79e;
        font-size: 12px;
        line-height: 1.7;
        margin: 0 0 25px;
      }

      .story-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid #30312b;
        font-size: 9px;
        letter-spacing: 1px;
        color: var(--lime);
      }

      .manifesto {
        padding: 54px;
        background: var(--lime);
        color: #151610;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        align-items: center;
      }

      .manifesto .eyebrow { color: #343b19; }

      .manifesto h2 {
        font-size: clamp(35px, 5vw, 58px);
        line-height: .98;
        margin-top: 16px;
      }

      .manifesto p {
        font-size: 14px;
        line-height: 1.9;
        max-width: 390px;
      }

      footer {
        border-top: 1px solid var(--line);
        padding: 28px 0;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        color: var(--muted);
        font-size: 10px;
      }

      @media (max-width: 760px) {
        .shell { width: min(100% - 32px, 560px); }
        header { height: 70px; }
        nav { gap: 14px; }
        nav a:not(.nav-cta) { display: none; }
        .hero {
          grid-template-columns: 1fr;
          padding: 65px 0 45px;
          gap: 34px;
        }
        h1 { letter-spacing: -4px; }
        .feature-visual { min-height: 290px; }
        .ticker-item { padding: 17px 10px; }
        .ticker strong { font-size: 10px; }
        .ticker span { font-size: 9px; }
        .section { padding: 58px 0; }
        .stories { grid-template-columns: 1fr; }
        .story { min-height: 220px; }
        .manifesto {
          grid-template-columns: 1fr;
          padding: 30px;
          gap: 10px;
        }
        footer { flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header>
        <a class="brand" href="#">anticipate<span>.</span></a>
        <nav aria-label="Main navigation">
          <a href="#research">Research</a>
          <a href="#lab">The Lab</a>
          <a href="#about">About</a>
          <a class="nav-cta" href="#research">Explore the data ↗</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <div>
            <div class="eyebrow">AN INDEPENDENT BASKETBALL PUBLICATION</div>
            <h1>The future<br />leaves <span>clues.</span></h1>
            <p class="hero-copy">
              Basketball is more than what happens on the court.
              We use data to find the patterns, challenge assumptions,
              and explore what might happen next.
            </p>
            <div class="hero-actions">
              <a class="button" href="#research">Explore the research ↗</a>
              <a class="button secondary" href="#about">Our approach</a>
            </div>
          </div>

          <div class="feature-visual" id="lab">
            <div class="visual-top">
              <span>ANTICIPATE / 001</span>
              <span>THE MODEL ROOM</span>
            </div>
            <div class="court"></div>
            <div class="big-number">01<span style="color:#f3f2eb">.</span></div>
            <div class="visual-caption">
              Every breakout has a backstory. Every trend leaves a signal.
              We're here to find it.
            </div>
            <div class="visual-bottom">
              <span>OBSERVE</span><span>ANALYSE</span><span>ANTICIPATE</span>
            </div>
          </div>
        </section>

        <div class="ticker">
          <div class="ticker-item">
            <strong>DISCOVER</strong>
            <span>Find the patterns others miss.</span>
          </div>
          <div class="ticker-item">
            <strong>UNDERSTAND</strong>
            <span>Look beyond the box score.</span>
          </div>
          <div class="ticker-item">
            <strong>ANTICIPATE</strong>
            <span>Explore what comes next.</span>
          </div>
        </div>

        <section class="section" id="research">
          <div class="section-head">
            <div>
              <div class="eyebrow">THE LATEST THINKING</div>
              <h2>Research &amp; insights.</h2>
            </div>
            <a class="section-link" href="#research">ALL RESEARCH ↗</a>
          </div>

          <div class="stories">
            {stories.map((story) => (
              <article class="story">
                <div class="story-top">
                  <span>{story.category}</span>
                  <span>NO. {story.number}</span>
                </div>
                <h3>{story.title}</h3>
                <p>{story.description}</p>
                <div class="story-bottom">
                  <span>{story.type}</span>
                  <span>COMING INTO FOCUS ↗</span>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="section" id="about">
          <div class="manifesto">
            <div>
              <div class="eyebrow">THE ANTICIPATE PRINCIPLE</div>
              <h2>Don't just watch<br />the game.<br />Read it.</h2>
            </div>
            <div>
              <p>
                We believe numbers tell better stories when you ask better
                questions. Anticipate brings basketball, statistical thinking,
                and curiosity together to make the game easier to understand.
              </p>
              <p>
                Independent research. Transparent methods. No certainty where
                there is only probability.
              </p>
              <a class="button secondary" href="#research" style="border-color:#343b19;color:#151610">
                See what we're exploring ↗
              </a>
            </div>
          </div>
        </section>
      </main>

      <footer>
        <a class="brand" href="#">anticipate<span>.</span></a>
        <span>BASKETBALL, THROUGH DATA.</span>
        <span>© 2026 ANTICIPATE. BUILT ON CURIOSITY.</span>
      </footer>
    </div>
  </body>
</html>
