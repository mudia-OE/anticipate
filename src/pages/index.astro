
---
import { nbaTimeMachineEpisodes } from "../data/nbaTimeMachineSeries.js";

const stories = [
  {
    category: "DEFENSIVE ANALYSIS",
    number: "01",
    title: "Did Rudy Gobert Deserve All Four of His DPOYs?",
    description: "Taking a closer look at Gobert's four Defensive Player of the Year awards and the numbers behind them.",
    type: "DATA DIVE"
  },
  {
    category: "NBA HISTORY",
    number: "02",
    title: "Where Does Carmelo Anthony Rank Among the Greatest Scorers?",
    description: "Examining Carmelo Anthony's place on the all-time scoring list, beyond just his career point total.",
    type: "RESEARCH"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
<meta name="description" content="Original NBA research, basketball data analysis and player predictions. Explore the numbers behind the game with Anticipate." />
<title>Anticipate | NBA Analytics, Research & Player Predictions</title>
<link rel="canonical" href="https://anticipate-peak.vercel.app/" />
<meta property="og:site_name" content="Anticipate" />
<meta property="og:type" content="website" />
<meta property="og:title" content="Anticipate | NBA Analytics, Research & Player Predictions" />
<meta property="og:description" content="Original NBA research, basketball data analysis and player predictions. Explore the numbers behind the game with Anticipate." />
<meta property="og:url" content="https://anticipate-peak.vercel.app/" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="Anticipate | NBA Analytics, Research & Player Predictions" />
<meta name="twitter:description" content="Original NBA research, basketball data analysis and player predictions. Explore the numbers behind the game with Anticipate." />
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite","name":"Anticipate","url":"https://anticipate-peak.vercel.app/","description":"Original NBA research, basketball data analysis and player predictions. Explore the numbers behind the game with Anticipate."})} />

<meta name="google-site-verification" content="mTUDZhCon_veP28F7jgU7xS9AymTbo1yD9pfW5jDbhc" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10110f" />
    
    
    <style>
      :root {
        font-family: Arial, Helvetica, sans-serif;
        color: #f3f2eb;
        background: #10110f;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        --bg: #10110f;
        --panel: #191a17;
        --muted: #999b91;
        --line: #30312b;
        --lime: #d4ff45;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; }
      a { color: inherit; text-decoration: none; }

      .shell {
        width: min(1160px, calc(100% - 48px));
        margin: 0 auto;
      }

      header {
        height: 82px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line);
      }

      .brand {
        font-size: 23px;
        font-weight: 900;
        letter-spacing: -1.2px;
      }

      .brand span { color: var(--lime); }

      nav {
        display: flex;
        gap: 30px;
        align-items: center;
        font-size: 12px;
        color: #c2c3ba;
      }

      nav a:hover { color: var(--lime); }

      .nav-cta {
        border: 1px solid #55564d;
        padding: 11px 15px;
        color: #fff;
      }

      .eyebrow {
        font-size: 10px;
        letter-spacing: 2px;
        font-weight: 700;
        color: var(--lime);
      }

      .hero {
        padding: 92px 0 70px;
        display: grid;
        grid-template-columns: 1.1fr .9fr;
        gap: 50px;
        align-items: center;
      }

      h1 {
        font-size: clamp(54px, 7.5vw, 100px);
        line-height: .91;
        letter-spacing: -7px;
        margin: 24px 0;
        font-weight: 900;
      }

      h1 span {
        color: var(--lime);
      }

      .hero-copy {
        max-width: 430px;
        font-size: 15px;
        line-height: 1.8;
        color: #b1b2a9;
      }

      .hero-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
        flex-wrap: wrap;
      }

      .button {
        display: inline-block;
        padding: 15px 19px;
        background: var(--lime);
        color: #11120e;
        font-size: 12px;
        font-weight: 800;
      }

      .button.secondary {
        color: #f3f2eb;
        background: transparent;
        border: 1px solid #484940;
      }

      .feature-visual {
        min-height: 350px;
        position: relative;
        overflow: hidden;
        background:
          radial-gradient(ellipse at 75% 30%, #3b4521 0%, transparent 45%),
          linear-gradient(145deg, #24271d, #151612 65%);
        border: 1px solid #35372c;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .visual-top, .visual-bottom {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 9px;
        letter-spacing: 1.5px;
        color: #b4b6a8;
      }

      .court {
        position: absolute;
        width: 280px;
        height: 280px;
        border: 1px solid #69713e;
        border-radius: 50%;
        right: -30px;
        top: 52px;
        opacity: .65;
      }

      .court::before {
        content: "";
        position: absolute;
        height: 100%;
        width: 1px;
        left: 50%;
        background: #69713e;
      }

      .court::after {
        content: "";
        position: absolute;
        width: 110px;
        height: 110px;
        border: 1px solid #69713e;
        border-radius: 50%;
        left: 84px;
        top: 84px;
      }

      .big-number {
        position: relative;
        z-index: 1;
        font-size: clamp(80px, 11vw, 132px);
        letter-spacing: -10px;
        font-weight: 900;
        line-height: 1;
        color: var(--lime);
      }

      .visual-caption {
        position: relative;
        z-index: 1;
        max-width: 230px;
        font-size: 12px;
        line-height: 1.6;
        color: #d2d3c9;
      }

      .ticker {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .ticker-item {
        padding: 22px 20px;
        border-right: 1px solid var(--line);
      }

      .ticker-item:last-child { border-right: 0; }

      .ticker strong {
        display: block;
        font-size: 12px;
        margin-bottom: 7px;
      }

      .ticker span {
        color: var(--muted);
        font-size: 11px;
      }

      .section { padding: 78px 0; }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
      }

      h2 {
        font-size: clamp(30px, 4vw, 44px);
        letter-spacing: -2px;
        margin: 12px 0 0;
      }

      .section-link {
        font-size: 11px;
        color: var(--lime);
      }

      .featured-story { display:block; padding:36px; margin-bottom:20px; background:linear-gradient(125deg,#242b19,#191a17); border:1px solid #485334; text-decoration:none; transition:border-color .2s; } .featured-story:hover{border-color:var(--lime)} .featured-story h3{font-size:clamp(30px,4vw,47px);letter-spacing:-1.5px;line-height:1.08;max-width:780px;margin:20px 0 15px}.featured-story h3 span,.featured-story strong{color:var(--lime)}.featured-story p{font-size:14px;color:#b7b9ae;line-height:1.7;max-width:620px}.featured-story strong{display:block;margin-top:25px;font-size:11px;letter-spacing:1px}
    .stories {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
      }

      .story {
        padding: 24px;
        background: var(--panel);
        border: 1px solid #292a25;
        min-height: 260px;
        display: flex;
        flex-direction: column;
        transition: border-color .2s, transform .2s;
      }

      .story:hover {
        border-color: var(--lime);
        transform: translateY(-3px);
      }

      .story-top {
        display: flex;
        justify-content: space-between;
        font-size: 9px;
        letter-spacing: 1px;
        color: var(--muted);
      }

      .story h3 {
        font-size: 23px;
        line-height: 1.15;
        letter-spacing: -.7px;
        margin: 36px 0 12px;
      }

      .story p {
        color: #a6a79e;
        font-size: 12px;
        line-height: 1.7;
        margin: 0 0 25px;
      }

      .story-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid #30312b;
        font-size: 9px;
        letter-spacing: 1px;
        color: var(--lime);
      }

      .manifesto {
        padding: 54px;
        background: var(--lime);
        color: #151610;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        align-items: center;
      }

      .manifesto .eyebrow { color: #343b19; }

      .manifesto h2 {
        font-size: clamp(35px, 5vw, 58px);
        line-height: .98;
        margin-top: 16px;
      }

      .manifesto p {
        font-size: 14px;
        line-height: 1.9;
        max-width: 390px;
      }

      footer {
        border-top: 1px solid var(--line);
        padding: 28px 0;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        color: var(--muted);
        font-size: 10px;
      }

      @media (max-width: 760px) {
        .shell { width: min(100% - 32px, 560px); }
        header { height: 70px; }
        nav { gap: 14px; }
        nav a:not(.nav-cta) { display: none; }
        .hero {
          grid-template-columns: 1fr;
          padding: 65px 0 45px;
          gap: 34px;
        }
        h1 { letter-spacing: -4px; }
        .feature-visual { min-height: 290px; }
        .ticker-item { padding: 17px 10px; }
        .ticker strong { font-size: 10px; }
        .ticker span { font-size: 9px; }
        .section { padding: 58px 0; }
        .stories { grid-template-columns: 1fr; }
        .story { min-height: 220px; }
        .manifesto {
          grid-template-columns: 1fr;
          padding: 30px;
          gap: 10px;
        }
        footer { flex-direction: column; }
      }
    @media(max-width:520px){.shell{width:calc(100% - 28px)}.hero{gap:24px}h1{letter-spacing:-3px;overflow-wrap:anywhere}nav{flex-wrap:wrap;justify-content:flex-end;gap:10px}.ticker{grid-template-columns:1fr}.ticker-item{border-right:0;border-bottom:1px solid var(--line)}.feature-visual{min-height:260px}}
.story-read{color:var(--lime);font-weight:800;text-decoration:none}.story-read:hover{text-decoration:underline}
      .series-spotlight{margin-bottom:20px;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;padding:27px 31px;background:linear-gradient(110deg,#232b1e,#1b221b 66%,#172622);border:1px solid #485a3b;text-decoration:none;transition:border-color .2s}
      .series-spotlight:hover{border-color:var(--lime)}.series-spotlight .spot-brow{font-size:10px;letter-spacing:1.6px;color:var(--lime);font-weight:800}
      .series-spotlight h3{font-size:clamp(22px,3.5vw,35px);line-height:1.16;letter-spacing:-1px;margin:13px 0;max-width:720px}.series-spotlight p{font-size:13px;line-height:1.65;color:#bfc7b6;margin:0;max-width:620px}
      .series-spotlight .spot-number{font-size:clamp(56px,8vw,92px);color:var(--lime);font-weight:900;letter-spacing:-6px;white-space:nowrap}
      .series-spotlight .spot-cta{font-size:11px;letter-spacing:1px;color:var(--lime);font-weight:800;display:inline-block;margin-top:16px}
      @media(max-width:760px){.series-spotlight{grid-template-columns:1fr;padding:22px}.series-spotlight .spot-number{display:none}}

      .main-feature {
        background: radial-gradient(ellipse at 90% 25%, #435525, transparent 52%), linear-gradient(120deg,#2d391e,#191d17 72%);
        border-color: #687d3f;
        padding: 43px;
      }
      .main-feature h3 {font-size:clamp(37px,4.8vw,58px); max-width:950px}
      .second-feature {padding:27px 33px; background:#1b1e18; border-color:#30382b;}
      .second-feature h3 {font-size:clamp(24px,3vw,33px); max-width:900px; margin:12px 0;}
      .second-feature p {font-size:12px;}
      .second-feature strong {margin-top:18px;}
      .stories {grid-template-columns:repeat(2,minmax(0,1fr))}
      .series-section {border-top:1px solid var(--line);padding-top:75px;}
      .series-intro {border:1px solid #45523a; padding:28px 30px;margin-bottom:14px;background:linear-gradient(120deg,#212b1c,#1b211a);display:flex;gap:30px;align-items:center;justify-content:space-between;}
      .series-intro p {max-width:640px;font-size:13px;line-height:1.8;color:#bfc4b8;margin:8px 0 0;}
      .series-intro .series-kicker {font-size:11px;letter-spacing:1.3px;color:var(--lime);font-weight:800;margin:0;}
      .series-explore {display:block;white-space:nowrap;font-size:11px;font-weight:800;letter-spacing:1px;color:#12160c;background:var(--lime);padding:15px 16px;}
      .episode-grid {display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;}
      .episode-tile {min-height:162px;padding:16px;display:flex;flex-direction:column;border:1px solid #363a32;background:#1a1c18;text-decoration:none;min-width:0;}
      .episode-top {display:flex;justify-content:space-between;align-items:center;gap:6px;margin-bottom:auto;}
      .episode-top b {color:#a7aea0;font-size:10px;letter-spacing:1.1px;}
      .episode-status {font-size:9px;font-weight:800;letter-spacing:.5px;white-space:nowrap;}
      .episode-status.locked {color:#999f94;}
      .episode-status.available {color:var(--lime);}
      .episode-tile strong {display:block;color:#eee;font-size:clamp(16px,1.6vw,23px);line-height:1.14;letter-spacing:-.5px;margin-top:20px;}
      .episode-season {font-size:10px;color:#9ea49b;margin-top:9px;}
      .episode-live {background:linear-gradient(140deg,#2a371c,#1d2419);border-color:#899c52;transition:border-color .2s,transform .2s;}
      .episode-live:hover {border-color:var(--lime);transform:translateY(-3px);}
      .episode-locked {opacity:.78;cursor:default;}
      @media(max-width:1000px) {.episode-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.series-intro{align-items:start;flex-direction:column;}}
      @media(max-width:760px) {.episode-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.series-section{padding-top:55px}.series-intro{padding:20px}.main-feature{padding:27px 23px}.main-feature h3{font-size:34px}.second-feature{padding:24px 23px}.stories{grid-template-columns:1fr}}
      @media(max-width:400px) {.episode-tile{padding:13px;min-height:149px}.episode-tile strong{font-size:17px}.episode-status{font-size:8px}}

</style>
  </head>
  <body>
    <div class="shell">
      <header>
        <a class="brand" href="#">anticipate<span>.</span></a>
        <nav aria-label="Main navigation">
          <a href="#research">Research</a>
          <a href="#series">Series</a>
          <a href="#lab">The Lab</a>
          <a href="#about">About</a>
          <a href="https://www.instagram.com/anticipate.peak/" target="_blank" rel="noopener noreferrer" aria-label="Anticipate on Instagram">Instagram ↗</a>
          <a class="nav-cta" href="#research">Explore the data ↗</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <div>
            <div class="eyebrow">AN INDEPENDENT BASKETBALL PUBLICATION</div>
            <h1>The future<br />leaves <span>clues.</span></h1>
            <p class="hero-copy">
              Anticipate is an independent NBA analytics publication.
              We use basketball data, statistical models, and original research
              to explore player performance, injuries, and what might happen next.
            </p>
            <div class="hero-actions">
              <a class="button" href="#research">Explore the research ↗</a>
              <a class="button secondary" href="#about">Our approach</a>
            </div>
          </div>

          <div class="feature-visual" id="lab">
            <div class="visual-top">
              <span>ANTICIPATE / 001</span>
              <span>THE MODEL ROOM</span>
            </div>
            <div class="court"></div>
            <div class="big-number">01<span style="color:#f3f2eb">.</span></div>
            <div class="visual-caption">
              Every breakout has a backstory. Every trend leaves a signal.
              We're here to find it.
            </div>
            <div class="visual-bottom">
              <span>OBSERVE</span><span>ANALYSE</span><span>ANTICIPATE</span>
            </div>
          </div>
        </section>

        <div class="ticker">
          <div class="ticker-item">
            <strong>DISCOVER</strong>
            <span>Find the patterns others miss.</span>
          </div>
          <div class="ticker-item">
            <strong>UNDERSTAND</strong>
            <span>Look beyond the box score.</span>
          </div>
          <div class="ticker-item">
            <strong>ANTICIPATE</strong>
            <span>Explore what comes next.</span>
          </div>
        </div>

        <section class="section" id="research">
          <div class="section-head">
            <div>
              <div class="eyebrow">THE LATEST THINKING</div>
              <h2>Research &amp; insights.</h2>
            </div>
            <a class="section-link" href="#research">ALL RESEARCH ↗</a>
          </div>

          <a href="/research/stockton-time-machine/" class="featured-story main-feature">
            <div class="eyebrow">FEATURED INVESTIGATION / NBA TIME MACHINE / EPISODE 01</div>
            <h3>We Looked for the Next <span>John Stockton.</span></h3>
            <p>279 players. Five closest matches. A playmaking profile nobody in 2025–26 could quite reproduce. Explore the interactive statistical and physical comparisons.</p>
            <strong>READ THE FEATURE ↗</strong>
          </a>
          <a href="/research/haliburton-achilles/" class="featured-story second-feature">
            <div class="eyebrow">MORE RESEARCH / THE MODEL ROOM</div>
            <h3>Tyrese Haliburton: A Career-Ending Injury? Or a <span>Career-Defining One?</span></h3>
            <p>24 NBA Achilles recoveries. One model. What the numbers suggest about Haliburton's return.</p>
            <strong>READ THE INVESTIGATION ↗</strong>
          </a>
          <div class="stories">
            {stories.map((story) => (
              <article class="story">
                <div class="story-top">
                  <span>{story.category}</span>
                  <span>NO. {story.number}</span>
                </div>
                <h3>{story.title}</h3>
                <p>{story.description}</p>
                <div class="story-bottom">
                  <span>{story.type}</span>
                  {story.href ? <a class="story-read" href={story.href}>READ EPISODE 01 ↗</a> : <span>COMING INTO FOCUS ↗</span>}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="section series-section" id="series" aria-labelledby="series-title">
          <div class="section-head">
            <div>
              <div class="eyebrow">ORIGINAL SERIES / SEASON ONE</div>
              <h2 id="series-title">NBA Time Machine.</h2>
            </div>
            <a class="section-link" href="/series/nba-time-machine/">VIEW THE SERIES ↗</a>
          </div>
          <div class="series-intro">
            <div>
              <p class="series-kicker">TEN LEGENDS. ONE MODERN NBA.</p>
              <p>What would the game's greatest players look like in 2025–26? We're taking it one legend at a time. Stockton is live. The next nine investigations are locked until release.</p>
            </div>
            <a class="series-explore" href="/series/nba-time-machine/">EXPLORE ALL EPISODES ↗</a>
          </div>
          <div class="episode-grid" aria-label="NBA Time Machine episode lineup">
            {nbaTimeMachineEpisodes.map((episode) => (
              episode.status === "published" ? (
                <a class="episode-tile episode-live" href={episode.href} aria-label={`Read NBA Time Machine episode ${episode.number}: ${episode.name}`}>
                  <span class="episode-top"><b>EP {episode.number}</b><span class="episode-status available">READ NOW ↗</span></span>
                  <strong>{episode.name}</strong>
                  <span class="episode-season">{episode.season}</span>
                </a>
              ) : (
                <article class="episode-tile episode-locked" aria-label={`Episode ${episode.number}: ${episode.name}, locked`}>
                  <span class="episode-top"><b>EP {episode.number}</b><span class="episode-status locked">🔒 LOCKED</span></span>
                  <strong>{episode.name}</strong>
                  <span class="episode-season">{episode.season}</span>
                </article>
              )
            ))}
          </div>
        </section>

        <section class="section" id="about">
          <div class="manifesto">
            <div>
              <div class="eyebrow">THE ANTICIPATE PRINCIPLE</div>
              <h2>Don't just watch<br />the game.<br />Read it.</h2>
            </div>
            <div>
              <p>
                We publish NBA data analysis, player projections, and original
                basketball research. Our goal is to make statistical findings
                understandable to fans without losing the details behind them.
              </p>
              <p>
                Independent research. Transparent methods. No certainty where
                there is only probability.
              </p>
              <a class="button secondary" href="#research" style="border-color:#343b19;color:#151610">
                See what we're exploring ↗
              </a>
            </div>
          </div>
        </section>
      </main>

      <footer>
        <a class="brand" href="#">anticipate<span>.</span></a>
        <a href="https://www.instagram.com/anticipate.peak/" target="_blank" rel="noopener noreferrer" aria-label="Follow Anticipate on Instagram">FOLLOW @ANTICIPATE.PEAK ↗</a>
        <span>© 2026 ANTICIPATE. BUILT ON CURIOSITY.</span>
      </footer>
    </div>
  </body>
</html>
