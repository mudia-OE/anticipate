---
const pageUrl = "https://anticipate-peak.vercel.app/research/stockton-time-machine/";
const stockton = {
  name: "John Stockton",
  pts100: 23, relative_ts: 7, ast_pct: 57.4, trb_pct: 4.1,
  usg_pct: 20.6, stl_pct: 3.5, blk_pct: 0.4,
  height_cm: 185, weight_lb: 170, role: "Guard"
};
const contenders = [
  {
    name: "Kevin Porter Jr.", short:"Porter Jr.", team:"MIL",
    distance:1.3000, pts100:25.8, relative_ts:-1.4, ast_pct:33.8, trb_pct:8.9,
    usg_pct:24.3, stl_pct:3.2, blk_pct:1.5, height_cm:196, weight_lb:203, role:"Guard",
    takeaway:"The model's winner. The scoring load and steal rate look familiar; the playmaking and efficiency don't.",
    statline:"He lands closest overall partly because of his scoring load and steals, not because he's a carbon copy of Stockton."
  },
  {
    name:"Tre Jones", short:"Tre Jones", team:"CHI",
    distance:1.3357, pts100:24.4, relative_ts:5.6, ast_pct:29.2, trb_pct:6.2,
    usg_pct:19.2, stl_pct:2.0, blk_pct:0.5, height_cm:185, weight_lb:190, role:"Guard",
    takeaway:"The size-and-efficiency argument. Same listed height, similar usage and a far closer efficiency profile.",
    statline:"If your mental picture of Stockton starts with a small, careful point guard, Jones might be the more recognizable answer."
  },
  {
    name:"Isaiah Collier", short:"Collier", team:"UTA",
    distance:1.3497, pts100:21.3, relative_ts:-1.4, ast_pct:39.2, trb_pct:5.3,
    usg_pct:20.4, stl_pct:2.0, blk_pct:1.3, height_cm:193, weight_lb:210, role:"Guard",
    takeaway:"The playmaking case. Among the top-five matches, Collier has the highest assist percentage.",
    statline:"Collier's assist share gets closest of these five, and even that leaves a huge gap to Stockton's 57.4%."
  },
  {
    name:"Jalen Suggs", short:"Suggs", team:"ORL",
    distance:1.4332, pts100:24.0, relative_ts:-2.0, ast_pct:29.6, trb_pct:7.8,
    usg_pct:22.9, stl_pct:3.2, blk_pct:2.3, height_cm:196, weight_lb:205, role:"Guard",
    takeaway:"The disruption case. Suggs comes closest to Stockton's steal percentage, but their offensive profiles separate.",
    statline:"The defensive activity jumps off the chart. The gap in creation and scoring efficiency is the other half of the story."
  },
  {
    name:"Ryan Rollins", short:"Rollins", team:"MIL",
    distance:1.4379, pts100:26.5, relative_ts:0.2, ast_pct:27.1, trb_pct:8.0,
    usg_pct:24.2, stl_pct:2.3, blk_pct:1.3, height_cm:191, weight_lb:180, role:"Guard",
    takeaway:"The compact-guard comparison. Rollins is relatively close in build, but further away in playmaking.",
    statline:"Rollins' size keeps him in the conversation, though his role as a creator was very different."
  }
];
const features = [
  {key:"pts100", short:"PTS/100", label:"Points per 100 possessions",min:0,max:50,unit:""},
  {key:"relative_ts",short:"rTS",label:"Relative true shooting",min:-10,max:15,unit:" pp"},
  {key:"ast_pct",short:"AST%",label:"Assist percentage",min:0,max:65,unit:"%"},
  {key:"trb_pct",short:"TRB%",label:"Total rebound percentage",min:0,max:25,unit:"%"},
  {key:"usg_pct",short:"USG%",label:"Usage percentage",min:0,max:45,unit:"%"},
  {key:"stl_pct",short:"STL%",label:"Steal percentage",min:0,max:5,unit:"%"},
  {key:"blk_pct",short:"BLK%",label:"Block percentage",min:0,max:10,unit:"%"}
];
const physicalAxes = [
 {key:"height_cm",short:"HEIGHT",label:"Height",min:0,max:230},
 {key:"weight_lb",short:"WEIGHT",label:"Weight",min:0,max:330},
 {key:"role",short:"GUARD",label:"Guard positional group",min:0,max:1}
];
const norm = (v, feature) => Math.max(0,Math.min(1,((feature.key === "role" ? (v.role === "Guard" ? 1:0):v[feature.key])-feature.min)/(feature.max-feature.min)));
const poly = (data, features, center=190, radius=125) => features.map((f,i)=>{
 const a=-Math.PI/2 + i * Math.PI*2/features.length;
 const d=norm(data,f) * radius;
 return (center+Math.cos(a)*d).toFixed(1)+","+(center+Math.sin(a)*d).toFixed(1);
}).join(" ");
const gridPoly = (features, fraction, center=190,radius=125) => features.map((_,i)=>{
 const a=-Math.PI/2 + i * Math.PI*2/features.length;
 return (center+Math.cos(a)*radius*fraction).toFixed(1)+","+(center+Math.sin(a)*radius*fraction).toFixed(1);
}).join(" ");
const labelPos=(i,n,center=190,radius=155)=>{
 const a=-Math.PI/2+i*2*Math.PI/n;return {x:center+Math.cos(a)*radius,y:center+Math.sin(a)*radius};
};
const comparisons = [
  {name:"Stockton '90",ast:57.4,type:"legend"},
  {name:"Jokić '26",ast:50.3,type:"other"},
  {name:"Cunningham '26",ast:45.2,type:"other"},
  {name:"Collier '26",ast:39.2,type:"other"},
  {name:"Porter Jr. '26",ast:33.8,type:"other"}
];
