<script type="application/json" id="contenders-data" set:html={JSON.stringify({stockton,contenders,features,physicalAxes})}></script>
<script is:inline>
(function(){
  const node=document.getElementById("contenders-data");
  if(!node)return;
  const data=JSON.parse(node.textContent || "{}");
  const comparePlayers=data.contenders || [];
  const buttons=Array.from(document.querySelectorAll("[data-pick]"));
  const norm=function(p,feature){
    const v=feature.key==="role"?(p.role==="Guard"?1:0):p[feature.key];
    return Math.max(0,Math.min(1,(v-feature.min)/(feature.max-feature.min)));
  };
  const poly=function(p,features){
    return features.map(function(f,i){
      const angle=-Math.PI/2+i*2*Math.PI/features.length;
      const n=norm(p,f)*125;
      return (190+Math.cos(angle)*n).toFixed(1)+","+(190+Math.sin(angle)*n).toFixed(1);
    }).join(" ");
  };
  function selectPlayer(index){
    const p=comparePlayers[index];if(!p)return;
    buttons.forEach(function(btn,i){btn.setAttribute("aria-pressed",i===index?"true":"false")});
    const stat=document.getElementById("modern-stat-shape"),body=document.getElementById("modern-physical-shape");
    if(stat)stat.setAttribute("points",poly(p,data.features));
    if(body)body.setAttribute("points",poly(p,data.physicalAxes));
    const title=document.getElementById("selected-name");
    if(title)title.textContent=p.name+" · 2025–26";
    const tableHead=document.getElementById("match-table-header");
    if(tableHead)tableHead.textContent=p.short+" '26";
    document.querySelectorAll("[data-value]").forEach(function(el){
      const feature=data.features.find(function(f){return f.key===el.dataset.value});
      if(feature)el.textContent=p[feature.key].toFixed(1)+feature.unit;
    });
    const h=document.getElementById("height-value"),w=document.getElementById("weight-value");
    if(h)h.textContent=p.height_cm+" cm";
    if(w)w.textContent=p.weight_lb+" lb";
    const hb=document.getElementById("height-bar"),wb=document.getElementById("weight-bar");
    if(hb)hb.style.width=(p.height_cm/230*100).toFixed(2)+"%";
    if(wb)wb.style.width=(p.weight_lb/330*100).toFixed(2)+"%";
    const take=document.getElementById("takeaway-copy"),takeTitle=document.getElementById("takeaway-title");
    if(takeTitle)takeTitle.textContent=p.name+" — rank "+(index+1)+" of 279";
    if(take)take.textContent=p.takeaway+" "+p.statline;
  }
  buttons.forEach(function(button,index){button.addEventListener("click",function(){selectPlayer(index)})});
})();
</script>
