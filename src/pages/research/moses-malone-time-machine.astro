---
const pageUrl = "https://anticipate-peak.vercel.app/research/moses-malone-time-machine/";
const heroImage = "https://cdn.nba.com/manage/2022/02/GettyImages-458875848-768x522.jpg";
const title = "We Tried to Find the Next Moses Malone";
const description = "We compared Moses Malone's 1982–83 MVP season with 279 NBA players from 2025–26. Karl-Anthony Towns topped the model, Jalen Duren challenged the basketball comparison, and the ranking changed when we changed the weights.";
const author = "Divine Osas-Egbe";
const moses = { name:"Moses Malone", team:"Philadelphia 76ers", year:"1982–83", pts100:30.5, rts:4.7, ast:5.1, trb:21.6, usage:26.0, steal:1.4, block:3.0, height:208, weight:215 };
const matches = [
 { name:"Karl-Anthony Towns",team:"New York Knicks",abbr:"NYK",distance:0.6510,pts100:32.1,rts:3.8,ast:14.7,trb:21.4,usage:25.9,steal:1.4,block:1.8,height:213,weight:248,three:36.8,minutes:2322,description:"The most convincing production-level match. His point production, usage, relative efficiency and total rebound share all sit strikingly close to Malone's. The perimeter shooting and face-up play tell a different story." },
 { name:"Jalen Duren",team:"Detroit Pistons",abbr:"DET",distance:0.6795,pts100:33.4,rts:10.7,ast:11.0,trb:20.9,usage:23.6,steal:1.4,block:3.0,height:208,weight:250,three:null,minutes:1976,description:"The closer stylistic argument: force near the basket, paint scoring, rim pressure and a 20.9% total rebound share. His era-relative efficiency is much higher; the model does not treat shot diet as a separate feature." },
 { name:"Kel'el Ware",team:"Miami Heat",abbr:"MIA",distance:0.7054,pts100:23.2,rts:3.5,ast:4.6,trb:21.1,usage:18.0,steal:1.6,block:4.4,height:213,weight:230,three:39.5,minutes:1704,description:"Very close rebound share and a lower-assist big-man role. The missing piece is scoring responsibility: Ware's usage and points per 100 possessions fall well short of Malone's season." },
 { name:"Jarrett Allen",team:"Cleveland Cavaliers",abbr:"CLE",distance:0.7214,pts100:27.2,rts:8.8,ast:9.7,trb:17.2,usage:19.9,steal:1.7,block:2.9,height:206,weight:243,three:10.0,minutes:1519,description:"Screening, finishing, protecting the rim and living inside. Allen fits the old-school center impression but gives up too much scoring burden and rebound share to reproduce this version of Moses." },
 { name:"Jalen Smith",team:"Chicago Bulls",abbr:"CHI",distance:0.8029,pts100:23.1,rts:2.7,ast:8.5,trb:17.2,usage:19.0,steal:1.0,block:3.3,height:203,weight:244,three:37.3,minutes:1095,description:"A more distant fifth-place result with some overlapping frontcourt production. His modest minutes and lower usage are significant differences, even though he clears our 1,000-minute threshold." }
];
const rankingPresets = {
 baseline:{ label:"Balanced",weights:"70 / 20 / 10",note:"Statistical production gets 70%; body measurements 20%; broad position group 10%. The published ranking.",players:[["Karl-Anthony Towns",.6510],["Jalen Duren",.6795],["Kel'el Ware",.7054],["Jarrett Allen",.7214],["Jalen Smith",.8029]] },
 scoring:{ label:"Production first",weights:"85 / 10 / 5",note:"Higher emphasis on points, efficiency, rebounding, usage, assists and stocks. Towns is still the closest match.",players:[["Karl-Anthony Towns",.5906],["Jalen Duren",.6375],["Jarrett Allen",.7271],["Kel'el Ware",.7398],["Jalen Smith",.8051]] },
 build:{ label:"Size and role",weights:"50 / 30 / 20",note:"More weight on listed height, weight and positional group. Kel'el Ware overtakes Towns. These are a different set of weights, not more trustworthy ones.",players:[["Kel'el Ware",.6466],["Karl-Anthony Towns",.6965],["Jarrett Allen",.6967],["Jalen Duren",.7068],["Ivica Zubac",.7653]] }
};
const axes = [
 {key:"pts100",label:"PTS / 100",full:"Points per 100 possessions",min:0,max:48,unit:""},
 {key:"rts",label:"rTS",full:"True shooting above league average",min:-5,max:14,unit:" pp"},
 {key:"ast",label:"AST%",full:"Assist percentage",min:0,max:40,unit:"%"},
 {key:"trb",label:"TRB%",full:"Total rebound percentage",min:0,max:27,unit:"%"},
 {key:"usage",label:"USG%",full:"Usage percentage",min:0,max:40,unit:"%"},
 {key:"steal",label:"STL%",full:"Steal percentage",min:0,max:4.5,unit:"%"},
 {key:"block",label:"BLK%",full:"Block percentage",min:0,max:7,unit:"%"}
];
const polar = (i,n,d) => ({x:240+Math.cos(-Math.PI/2+2*Math.PI*i/n)*d,y:211+Math.sin(-Math.PI/2+2*Math.PI*i/n)*d});
const radarPolygon = (profile,r=132) => axes.map((m,i)=>{const v=Math.max(0,Math.min(1,(profile[m.key]-m.min)/(m.max-m.min)));const p=polar(i,axes.length,r*v);return p.x.toFixed(1)+","+p.y.toFixed(1)}).join(" ");
const radarRing = fraction => axes.map((m,i)=>{const p=polar(i,axes.length,132*fraction);return p.x.toFixed(1)+","+p.y.toFixed(1)}).join(" ");
const sources = [
 {name:"NBA.com — Moses Malone, Legends profile",url:"https://www.nba.com/news/history-nba-legend-moses-malone",note:"Career, professional debut, the trade to Philadelphia, three MVPs and the 1983 championship."},
 {name:"Philadelphia 76ers — Moses Malone alumni profile",url:"https://www.nba.com/sixers/76ers-alumni/moses-malone",note:"1982–83 season, the 65–17 Sixers, playoff run and Finals MVP."},
 {name:"NBA.com — 1982–83 season review",url:"https://www.nba.com/news/history-season-review-1982-83",note:"Contemporary team context, award results and the 1983 postseason."},
 {name:"Basketball-Reference — Moses Malone",url:"https://www.basketball-reference.com/players/m/malonmo01.html",note:"Historical 1982–83 per-game totals, 5.7 offensive rebounds per game and listed measurements."},
 {name:"Basketball-Reference — 1982–83 advanced stats",url:"https://www.basketball-reference.com/leagues/NBA_1983_advanced.html",note:"Historical TS%, rebound%, assist%, usage%, steals% and blocks%."},
 {name:"StatMuse — NBA league TS% by season",url:"https://www.statmuse.com/nba/ask/nba-league-average-ts-season-by-season-since-1980",note:"1982–83 league true shooting of 53.1%, making Moses's 57.8% a +4.7 percentage-point rTS."},
 {name:"Basketball-Reference — 2025–26 advanced stats",url:"https://www.basketball-reference.com/leagues/NBA_2026_advanced.html",note:"Season-wide modern player efficiency and possession-based statistics."},
 {name:"Anticipate — NBA Time Machine reproducible model",url:"https://github.com/mudia-OE/anticipate-nba-time-machine",note:"279-player source CSV, supplied 1982–83 reference profile, R model, distance results and exact method."}
];
const labDataJson = JSON.stringify({moses,matches,axes,rankingPresets});
