<script is:inline>
(function(){
  const el = document.getElementById("research-data");
  if (!el) return;
  let data;
  try { data=JSON.parse(el.textContent); } catch(_e) { return; }
  const axes=data.axes;
  const polar=(i,n,d)=>({x:240+Math.cos(-Math.PI/2+2*Math.PI*i/n)*d,y:211+Math.sin(-Math.PI/2+2*Math.PI*i/n)*d});
  const points=p=>axes.map((a,i)=>{const v=Math.max(0,Math.min(1,(Number(p[a.key])-a.min)/(a.max-a.min)));const q=polar(i,axes.length,132*v);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
  const valueList=document.getElementById("lab-values");
  const polygon=document.getElementById("peer-polygon");
  const radar=document.querySelector(".radar-svg");
  document.querySelectorAll("[data-player-index]").forEach(button=>button.addEventListener("click",()=>{
    const index=Number(button.getAttribute("data-player-index"));
    const p=data.matches[index];
    if(!p)return;
    document.querySelectorAll("[data-player-index]").forEach(b=>b.setAttribute("aria-pressed",b===button?"true":"false"));
    polygon.setAttribute("points",points(p));
    document.getElementById("lab-name").textContent=p.name;
    document.getElementById("legend-player").textContent=p.name;
    document.getElementById("lab-description").textContent=p.description;
    radar.setAttribute("aria-label","Statistical radar chart comparing Moses Malone with "+p.name);
    valueList.textContent="";
    axes.forEach(a=>{
      const div=document.createElement("div"),dt=document.createElement("dt"),dd=document.createElement("dd"),strong=document.createElement("strong");
      dt.textContent=a.label;strong.textContent=Number(data.moses[a.key]).toFixed(1);dd.append(strong,document.createTextNode(" / "+Number(p[a.key]).toFixed(1)));div.append(dt,dd);valueList.append(div);
    });
  }));
  const presetResults=document.getElementById("preset-results");
  document.querySelectorAll("[data-preset]").forEach(button=>button.addEventListener("click",()=>{
    const key=button.getAttribute("data-preset");
    const preset=data.rankingPresets[key];
    if(!preset)return;
    document.querySelectorAll("[data-preset]").forEach(b=>b.setAttribute("aria-pressed",b===button?"true":"false"));
    document.getElementById("preset-weights").textContent=preset.weights;
    document.getElementById("preset-note").textContent=preset.note;
    presetResults.textContent="";
    preset.players.forEach((entry,i)=>{
      const li=document.createElement("li"),rank=document.createElement("span"),score=document.createElement("span");
      rank.textContent=String(i+1).padStart(2,"0");score.textContent=Number(entry[1]).toFixed(4);score.className="right";
      li.append(rank,document.createTextNode(entry[0]),score);presetResults.append(li);
    });
  }));
})();
