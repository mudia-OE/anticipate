---
const pageUrl = "https://anticipate-peak.vercel.app/research/larry-bird-time-machine/";
const heroImage = "https://cdn.nba.com/manage/2018/10/larry-bird-1568x882.jpg";
const title = "We Tried to Find the Next Larry Bird. The Model Picked Michael Porter Jr.";
const description = "We compared Larry Bird's 1984–85 MVP season with 279 NBA players from 2025–26. Michael Porter Jr. ranked first, Jalen Johnson second. Explore the data, the player comparisons, the model and what the numbers cannot capture.";
const author = "Divine Osas-Egbe";
const players = [
  {name:"Michael Porter Jr.",team:"Brooklyn Nets",position:"Forward",rank:1,distance:0.4853,pts100:36.9,rts:1.4,ast:18.2,trb:12.6,usage:30.5,steal:1.6,block:0.7,height:208,weight:218,pts:24.2,reb:7.1,apg:3.0},
  {name:"Jalen Johnson",team:"Atlanta Hawks",position:"Forward",rank:2,distance:0.4996,pts100:30.2,rts:0.0,ast:33.5,trb:15.9,usage:27.0,steal:1.7,block:1.1,height:203,weight:219,pts:22.5,reb:10.3,apg:7.9},
  {name:"Franz Wagner",team:"Orlando Magic",position:"Forward",rank:3,distance:0.5913,pts100:32.9,rts:0.7,ast:18.2,trb:9.7,usage:27.0,steal:1.5,block:1.0,height:208,weight:220,pts:null,reb:null,apg:null},
  {name:"Deni Avdija",team:"Portland Trail Blazers",position:"Forward",rank:4,distance:0.5965,pts100:34.7,rts:1.9,ast:32.2,trb:11.2,usage:29.3,steal:1.1,block:1.7,height:203,weight:228,pts:null,reb:null,apg:null},
  {name:"LeBron James",team:"Los Angeles Lakers",position:"Forward",rank:5,distance:0.6398,pts100:30.8,rts:1.3,ast:34.1,trb:10.7,usage:27.2,steal:1.8,block:1.6,height:206,weight:250,pts:null,reb:null,apg:null},
];
const bird = {name:"Larry Bird",season:"1984–85",pts100:34.3,rts:4.2,ast:25.7,trb:14.7,usage:28.5,steal:1.9,block:1.7,height:206,weight:220};
const measures = [
 {key:"pts100",title:"Scoring volume",code:"PTS/100",max:48,unit:""},
 {key:"rts",title:"Era-relative efficiency",code:"rTS",min:-5,max:12,unit:" pp"},
 {key:"ast",title:"Share of teammates' assisted baskets",code:"AST%",max:52,unit:"%"},
 {key:"trb",title:"Share of available rebounds",code:"TRB%",max:23,unit:"%"},
 {key:"usage",title:"Offensive usage",code:"USG%",max:42,unit:"%"},
 {key:"steal",title:"Steal percentage",code:"STL%",max:4.5,unit:"%"},
 {key:"block",title:"Block percentage",code:"BLK%",max:4,unit:"%"},
];
const physicalMeasures = [
 {key:"height",title:"Listed height",code:"HEIGHT",min:175,max:225,unit:" cm"},
 {key:"weight",title:"Listed weight",code:"WEIGHT",min:150,max:320,unit:" lb"},
 {key:"roleMatch",title:"Same broad position group",code:"FORWARD",min:0,max:1,unit:""},
];
const radialPoint = (i,count,dist,centerX=210,centerY=194) => {
 const angle = -Math.PI/2 + 2*Math.PI*i/count;
 return {x:centerX+Math.cos(angle)*dist,y:centerY+Math.sin(angle)*dist};
};
const radarPoints = (profile,axes, radius=129) => axes.map((axis,i)=>{
 const val=axis.key==="roleMatch"?(profile.position==="Forward"||profile.name==="Larry Bird"?1:0):profile[axis.key];
 const fraction=Math.max(0,Math.min(1,(val-(axis.min??0))/(axis.max-(axis.min??0))));
 const p=radialPoint(i,axes.length,radius*fraction);
 return p.x.toFixed(2)+","+p.y.toFixed(2);
}).join(" ");
const radarRing = (axes,fraction) => axes.map((axis,i)=>{
 const p=radialPoint(i,axes.length,129*fraction);
 return p.x.toFixed(2)+","+p.y.toFixed(2);
}).join(" ");
const rankingPresets = {
 balanced: [{name:"Michael Porter Jr.",distance:0.4853},{name:"Jalen Johnson",distance:0.4996},{name:"Franz Wagner",distance:0.5913},{name:"Deni Avdija",distance:0.5965},{name:"LeBron James",distance:0.6398}],
 production: [{name:"Michael Porter Jr.",distance:0.5300},{name:"Jalen Johnson",distance:0.5410},{name:"LeBron James",distance:0.6195},{name:"Julius Randle",distance:0.6304},{name:"Deni Avdija",distance:0.6432}],
 build: [{name:"Michael Porter Jr.",distance:0.4169},{name:"Jalen Johnson",distance:0.4356},{name:"Franz Wagner",distance:0.5047},{name:"Deni Avdija",distance:0.5238},{name:"Cooper Flagg",distance:0.6194}],
};
const sources = [
 {name:"NBA: Legends Profile, Larry Bird",url:"https://www.nba.com/news/history-nba-legend-larry-bird",note:"Career history, playing identity, honours, rivalry and biographical context."},
 {name:"NBA: Boston's MVP seasons",url:"https://www.nba.com/news/regular-season-kia-nba-most-valuable-player-award-winners-boston-celtics",note:"Bird's 1984–85 MVP season scoring, rebounding, passing and shooting."},
 {name:"NBA: 1984–85 season review",url:"https://www.nba.com/news/history-season-review-1984-85",note:"Boston's 63-win season and 1985 Finals result."},
 {name:"NBA: Bird's 60-point night",url:"https://www.nba.com/news/legendary-moments-larry-bird-60-points-vs-hawks",note:"March 12, 1985, against Atlanta."},
 {name:"Basketball-Reference: Larry Bird",url:"https://www.basketball-reference.com/players/b/birdla01.html",note:"Historical per-game, per-possession and advanced metrics."},
 {name:"Basketball-Reference: 1984–85 league",url:"https://www.basketball-reference.com/leagues/NBA_1985.html",note:"League average true shooting of 54.3%, for era-relative adjustment."},
 {name:"Basketball-Reference: 2025–26 Brooklyn",url:"https://www.basketball-reference.com/teams/BRK/2026.html",note:"Michael Porter Jr.'s 2025–26 per-game statistics."},
 {name:"Basketball-Reference: 2025–26 Atlanta",url:"https://www.basketball-reference.com/teams/ATL/2026.html",note:"Jalen Johnson's 2025–26 per-game statistics."},
 {name:"Anticipate: NBA Time Machine code and data",url:"https://github.com/mudia-OE/anticipate-nba-time-machine",note:"279-player dataset, original model and reproducible R calculations."}
];
