return (210+Math.cos(angle)*129*scale).toFixed(2)+","+(194+Math.sin(angle)*129*scale).toFixed(2);
}).join(" ");
}
function selectPlayer(index){
const person=current[index];if(!person)return;
playerButtons.forEach((b,i)=>b.setAttribute("aria-pressed",String(i===index)));
document.getElementById("chosen-name").textContent=person.name;
document.getElementById("chosen-detail").textContent=person.team+" · distance "+person.distance.toFixed(4);
const statsShape=document.getElementById("stats-radar-modern");
const bodyShape=document.getElementById("physical-radar-modern");
statsShape?.setAttribute("points",radarPolygon(person,metrics));
bodyShape?.setAttribute("points",radarPolygon(person,physicalMetrics));
document.getElementById("stats-radar-title").textContent="Bird versus "+person.name+": statistical radar";
document.getElementById("physical-radar-title").textContent="Bird versus "+person.name+": physical radar";
document.getElementById("selected-values-header").textContent=person.name+" '26";
document.querySelectorAll("[data-radar-value]").forEach(cell=>{
const key=cell.getAttribute("data-radar-value");
const axis=[...metrics,...physicalMetrics].find(m=>m.key===key);
if(!axis)return;
cell.textContent=key==="roleMatch"?"Forward":person[key].toFixed(1)+axis.unit;
});
}
playerButtons.forEach(button=>button.addEventListener("click",()=>selectPlayer(Number(button.dataset.player))));
const presetRanks={
balanced:[["Michael Porter Jr.",.4853],["Jalen Johnson",.4996],["Franz Wagner",.5913],["Deni Avdija",.5965],["LeBron James",.6398]],
production:[["Michael Porter Jr.",.5300],["Jalen Johnson",.5410],["LeBron James",.6195],["Julius Randle",.6304],["Deni Avdija",.6432]],
build:[["Michael Porter Jr.",.4169],["Jalen Johnson",.4356],["Franz Wagner",.5047],["Deni Avdija",.5238],["Cooper Flagg",.6194]]};
const presetDescriptions={
balanced:"Published model: 70% statistical profile, 20% physical profile, 10% position. Porter Jr. leads Jalen Johnson by 0.0143 distance points.",
production:"Production first: 85% statistics, 10% physical, 5% position. Porter stays first, while LeBron and Julius Randle move into the top four.",
build:"Build + role: 50% statistics, 30% physical, 20% position. Porter remains first; Franz Wagner holds third and Cooper Flagg enters the top five."
};
const presets=Array.from(document.querySelectorAll("[data-preset]"));
function choosePreset(key){
if(!presetRanks[key])return;
presets.forEach(b=>b.setAttribute("aria-pressed",String(b.dataset.preset===key)));
const container=document.getElementById("preset-results");if(!container)return;container.replaceChildren();
presetRanks[key].forEach((item,i)=>{const card=document.createElement("div");card.className="rankcard";const rank=document.createElement("b");rank.textContent="RANK 0"+(i+1);const n=document.createElement("h4");n.textContent=item[0];const d=document.createElement("small");d.textContent=item[1].toFixed(4)+" distance";card.append(rank,n,d);container.append(card)});
document.getElementById("preset-explainer").textContent=presetDescriptions[key];
}
presets.forEach(b=>b.addEventListener("click",()=>choosePreset(b.dataset.preset)));
</script>
</body>
</html>
