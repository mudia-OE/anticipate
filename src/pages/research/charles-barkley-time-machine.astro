const dimensions=[
 {k:"pts100",name:"PTS/100",min:0,max:48,fmt:"num",table:"Points / 100 possessions"},
 {k:"relative_ts",name:"rTS",min:-10,max:16,fmt:"signed",table:"Relative true shooting (pp)"},
 {k:"ast_pct",name:"AST%",min:0,max:60,fmt:"percent",table:"Assist percentage"},
 {k:"trb_pct",name:"TRB%",min:0,max:27,fmt:"percent",table:"Total rebound percentage"},
 {k:"usg_pct",name:"USG%",min:0,max:42,fmt:"percent",table:"Usage percentage"},
 {k:"stl_pct",name:"STL%",min:0,max:5,fmt:"percent",table:"Steal percentage"},
 {k:"blk_pct",name:"BLK%",min:0,max:8,fmt:"percent",table:"Block percentage"}
];
const weights={balanced:[.7,.2,.1],stats:[.85,.1,.05],size:[.5,.3,.2]};
let mode="balanced";let selected="Jarrett Allen";
const ns="http://www.w3.org/2000/svg";
const byId=(id)=>document.getElementById(id);
const fmt=(n)=>Number(n).toFixed(3);
const score=(r)=>Math.sqrt(weights[mode][0]*r.s+weights[mode][1]*r.p+weights[mode][2]*r.c);
const ranking=()=>candidates.slice().sort((a,b)=>score(a)-score(b));
function elem(type,attrs){const e=document.createElementNS(ns,type);Object.keys(attrs||{}).forEach(k=>e.setAttribute(k,String(attrs[k])));return e;}
function pt(i,f,r){const a=-Math.PI/2+2*Math.PI*i/dimensions.length;return [(210+Math.cos(a)*r*f).toFixed(1),(210+Math.sin(a)*r*f).toFixed(1)].join(",");}
function points(p){return dimensions.map((f,i)=>{const value=(p[f.k]-f.min)/(f.max-f.min);return pt(i,Math.max(0,Math.min(1,value)),140);}).join(" ");}
function radar(player){
 const root=byId("statRadar");if(!root)return;root.replaceChildren();
 for(let r=1;r<=4;r++){root.append(elem("polygon",{points:dimensions.map((f,i)=>pt(i,r/4,140)).join(" "),fill:"none",stroke:"#3f493d","stroke-width":"1"}));}
 dimensions.forEach((f,i)=>{
 const p=pt(i,1,140).split(",");root.append(elem("line",{x1:210,y1:210,x2:p[0],y2:p[1],stroke:"#485344"}));
 const pos=pt(i,1,176).split(",");const t=elem("text",{x:pos[0],y:pos[1],"font-size":"11","font-weight":"700",fill:"#e1e8da","text-anchor":"middle","dominant-baseline":"middle"});t.textContent=f.name;root.append(t);
 });
 root.append(elem("polygon",{points:points(bark),fill:"#d4ff4533",stroke:"#d4ff45","stroke-width":"3","stroke-linejoin":"round"}));
 root.append(elem("polygon",{points:points(player),fill:"#80cfc633",stroke:"#80cfc6","stroke-width":"3","stroke-linejoin":"round"}));
 root.setAttribute("aria-label","Seven-stat radar comparing Charles Barkley in 1986–87 and "+player.name+" in 2025–26");
}
function bars(player){
 const root=byId("bodyBars");root.replaceChildren();
 [["HEIGHT",bark.height_cm,player.height_cm,230," cm"],["WEIGHT",bark.weight_lb,player.weight_lb,330," lb"]].forEach(x=>{
 const wrap=document.createElement("div");wrap.className="physical-row";
 const head=document.createElement("div");head.className="headline";
 const left=document.createElement("span");left.textContent=x[0];
 const right=document.createElement("span");right.textContent=x[1]+x[4]+" vs "+x[2]+x[4];
 head.append(left,right);
 const track=document.createElement("div");track.className="track";
 const legacy=document.createElement("div");legacy.className="bar legacy";legacy.style.width=(x[1]/x[3]*100)+"%";
 const modern=document.createElement("div");modern.className="bar modern";modern.style.width=(x[2]/x[3]*100)+"%";
 track.append(legacy,modern);wrap.append(head,track);root.append(wrap);
 });
}
function field(value,f){if(f.fmt==="signed")return (value>0?"+":"")+Number(value).toFixed(1);if(f.fmt==="percent")return Number(value).toFixed(1)+"%";return Number(value).toFixed(1);}
function profile(){
 const player=profiles.find(p=>p.name===selected);if(!player)return;
 byId("matchTitle").textContent="Barkley vs "+player.name;
 byId("modernTableHeading").textContent=(player.name.split(" ").slice(-1)[0]).toUpperCase()+" '26";
 const ranks=ranking();const idx=ranks.findIndex(x=>x.n===selected);byId("matchDistance").textContent=fmt(score(ranks[idx]));byId("matchRank").textContent="distance · rank "+(idx+1)+" of 279";
 byId("matchReadout").textContent=player.blurb;
 const body=byId("statsBody");body.replaceChildren();
 dimensions.forEach(f=>{const tr=document.createElement("tr");[f.table,field(bark[f.k],f),field(player[f.k],f)].forEach(value=>{const td=document.createElement("td");td.textContent=value;tr.append(td)});body.append(tr);});
 radar(player);bars(player);
 document.querySelectorAll(".playerpick").forEach(b=>b.setAttribute("aria-pressed",String(b.dataset.name===selected)));
}
function rerank(){
 const ranks=ranking();const root=byId("rankingList");root.replaceChildren();
 ranks.slice(0,5).forEach((r,i)=>{
 const div=document.createElement("div");div.className="rankrow";
 const ix=document.createElement("span");ix.className="position";ix.textContent=String(i+1).padStart(2,"0");
 const name=document.createElement("span");name.className="name";name.textContent=r.n;
 const sub=document.createElement("small");sub.textContent=r.g;name.append(sub);
 const dist=document.createElement("span");dist.className="distance";dist.textContent=fmt(score(r));
 div.append(ix,name,dist);root.append(div);
 });
 const zi=ranks.findIndex(x=>x.n==="Zion Williamson");byId("zionRank").textContent="#"+(zi+1);byId("zionScore").textContent="Distance "+fmt(score(ranks[zi]))+" under the selected weights";
 document.querySelectorAll(".preset").forEach(b=>b.setAttribute("aria-pressed",String(b.dataset.mode===mode)));
 profile();
}
document.querySelectorAll(".playerpick").forEach(b=>b.addEventListener("click",()=>{selected=b.dataset.name;profile();}));
document.querySelectorAll(".preset").forEach(b=>b.addEventListener("click",()=>{mode=b.dataset.mode;rerank();}));
rerank();
})();
