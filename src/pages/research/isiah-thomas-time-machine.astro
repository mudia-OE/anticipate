<script type="application/json" id="zeke-data" set:html={JSON.stringify({isiah,players,stats,physical})}></script>
<script is:inline>
(() => {
  const d=document.getElementById('zeke-data');if(!d)return;
  const {players,stats,physical}=JSON.parse(d.textContent||'{}');
  const buttons=[...document.querySelectorAll('[data-pick]')];
  function coords(p,axes){return axes.map((f,i)=>{const v=f.key==='role'?(p.role==='Guard'?1:0):p[f.key];const normalized=Math.max(0,Math.min(1,(v-f.low)/(f.high-f.low)));const angle=-Math.PI/2+i*2*Math.PI/axes.length;const r=137*normalized;return (205+Math.cos(angle)*r).toFixed(1)+','+(205+Math.sin(angle)*r).toFixed(1)}).join(' ')}
  function choose(i){
    const p=players[i];if(!p)return;
    for(let j=0;j<buttons.length;j++)buttons[j].setAttribute('aria-pressed',j===i?'true':'false');
    const name=document.getElementById('current-name');if(name)name.textContent=p.name+' (2025–26)';
    const sp=document.getElementById('modern-stats-shape'),ph=document.getElementById('modern-physical-shape');
    if(sp)sp.setAttribute('points',coords(p,stats));if(ph)ph.setAttribute('points',coords(p,physical));
    const measures=document.getElementById('match-measures');if(measures)measures.textContent=p.short+': '+p.height_cm+' cm / '+p.weight_lb+' lb';
    const insight=document.getElementById('match-insight');if(insight)insight.textContent=p.readout;
    const col=document.getElementById('column-name');if(col)col.textContent=p.short+" '26";
    for(const el of document.querySelectorAll('[data-stat]')){const f=stats.find(x=>x.key===el.dataset.stat);if(f)el.textContent=Number(p[f.key]).toFixed(1)+f.suffix;}
  }
  for(let i=0;i<buttons.length;i++)buttons[i].addEventListener('click',()=>choose(i));
})();
</script>
