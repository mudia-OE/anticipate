const pageUrl = 'https://anticipate-peak.vercel.app/research/isiah-thomas-time-machine/';
const imageUrl = 'https://anticipate-peak.vercel.app/images/isiah-thomas-pistons.jpg';
const isiah = {name:'Isiah Thomas',short:'Isiah',season:'1984–85',pts100:25.5,relative_ts:-1.4,ast_pct:47.9,trb_pct:6.1,usg_pct:24.0,stl_pct:2.8,blk_pct:0.4,height_cm:185,weight_lb:180,role:'Guard'};
const stockton = {name:'John Stockton',short:'Stockton',season:'1989–90',pts100:23.0,relative_ts:7.0,ast_pct:57.4,trb_pct:4.1,usg_pct:20.6,stl_pct:3.5,blk_pct:0.4,height_cm:185,weight_lb:170,role:'Guard'};
const players = [
  {name:'Isaiah Collier',short:'Collier',team:'UTA',season:'2025–26',rank:1,distance:0.8110,pts100:21.3,relative_ts:-1.4,ast_pct:39.2,trb_pct:5.3,usg_pct:20.4,stl_pct:2.0,blk_pct:1.3,height_cm:193,weight_lb:210,role:'Guard',readout:'The clearest match among qualifying 2025–26 players. His efficiency sits right alongside Isiah’s, although Zeke created more and Collier is noticeably bigger.'},
  {name:'Kevin Porter Jr.',short:'Porter Jr.',team:'MIL',season:'2025–26',rank:2,distance:0.8287,pts100:25.8,relative_ts:-1.4,ast_pct:33.8,trb_pct:8.9,usg_pct:24.3,stl_pct:3.2,blk_pct:1.5,height_cm:196,weight_lb:203,role:'Guard',readout:'Almost identical scoring per 100, usage and relative efficiency. The biggest separation is passing, plus the extra height and weight.'},
  {name:'Ryan Rollins',short:'Rollins',team:'MIL',season:'2025–26',rank:3,distance:0.8707,pts100:26.5,relative_ts:0.2,ast_pct:27.1,trb_pct:8.0,usg_pct:24.2,stl_pct:2.3,blk_pct:1.3,height_cm:191,weight_lb:180,role:'Guard',readout:'The volume and physical measurements are close, but his share of assisted baskets falls well short of Isiah’s.'},
  {name:"De'Aaron Fox",short:'Fox',team:'SAS',season:'2025–26',rank:4,distance:0.8743,pts100:28.8,relative_ts:-0.3,ast_pct:29.6,trb_pct:6.5,usg_pct:24.9,stl_pct:1.9,blk_pct:0.8,height_cm:191,weight_lb:185,role:'Guard',readout:'Fox gets close in guard-sized build and offensive responsibility, but takes on more scoring and far less playmaking.'},
  {name:'Darius Garland',short:'Garland',team:'2TM',season:'2025–26',rank:5,distance:0.8774,pts100:30.6,relative_ts:0.1,ast_pct:34.9,trb_pct:4.5,usg_pct:27.4,stl_pct:1.6,blk_pct:0.6,height_cm:185,weight_lb:192,role:'Guard',readout:'The same listed height, with a more modern scoring load. Garland is closer physically than most, but the steals and assist share still differ.'}
];
// Out-of-sample research comparison, NOT part of the 2025–26 eligibility ranking.
const trae = {name:'Trae Young',short:'Trae',team:'ATL',season:'2024–25',rank:null,distance:0.8093,pts100:31.4,relative_ts:-0.9,ast_pct:46.4,trb_pct:4.7,usg_pct:29.6,stl_pct:1.6,blk_pct:0.4,height_cm:188,weight_lb:164,role:'Guard',readout:'Trae nearly reproduces Isiah’s assist share while carrying more scoring usage. The lower steal rate and lighter frame tell a different story.'};
const stats = [
 {key:'pts100',label:'Points / 100',short:'PTS',low:0,high:48,suffix:''},
 {key:'relative_ts',label:'Relative TS',short:'rTS',low:-10,high:15,suffix:' pp'},
 {key:'ast_pct',label:'Assist percentage',short:'AST%',low:0,high:65,suffix:'%'},
 {key:'trb_pct',label:'Rebound percentage',short:'TRB%',low:0,high:22,suffix:'%'},
 {key:'usg_pct',label:'Usage percentage',short:'USG%',low:0,high:42,suffix:'%'},
 {key:'stl_pct',label:'Steal percentage',short:'STL%',low:0,high:5,suffix:'%'},
 {key:'blk_pct',label:'Block percentage',short:'BLK%',low:0,high:6,suffix:'%'}
];
const physical = [
 {key:'height_cm',label:'Height',short:'HEIGHT',low:0,high:230,suffix:' cm'},
 {key:'weight_lb',label:'Weight',short:'WEIGHT',low:0,high:330,suffix:' lb'},
 {key:'role',label:'Guard category',short:'GUARD',low:0,high:1,suffix:''}
];
const clamp = (x) => Math.max(0,Math.min(1,x));
const normalize = (p,f) => clamp(((f.key==='role'?(p.role==='Guard'?1:0):p[f.key])-f.low)/(f.high-f.low));
const polygon = (p,axes,c=205,r=137) => axes.map((f,i)=>{let a=-Math.PI/2+i*2*Math.PI/axes.length;let rr=r*normalize(p,f);return `${(c+Math.cos(a)*rr).toFixed(1)},${(c+Math.sin(a)*rr).toFixed(1)}`;}).join(' ');
const ring = (axes,scale,c=205,r=137) => axes.map((_,i)=>{let a=-Math.PI/2+i*2*Math.PI/axes.length;return `${(c+Math.cos(a)*r*scale).toFixed(1)},${(c+Math.sin(a)*r*scale).toFixed(1)}`;}).join(' ');
const endpoint = (i,n,factor=1,c=205,r=137) => {let a=-Math.PI/2+i*2*Math.PI/n;return {x:c+Math.cos(a)*r*factor,y:c+Math.sin(a)*r*factor};};
const scoreFmt = n => Number(n).toFixed(3);
