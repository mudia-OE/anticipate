.detail-panel h4{font-size:24px;margin:6px 0 10px;line-height:1.2}.detail-panel p{font-size:12px;color:var(--muted);line-height:1.65}.comparison-values{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:16px 0}.comparison-values div{padding:9px;background:#222b21;border:1px solid #354535;min-width:0}.comparison-values dt{font-size:10px;color:var(--muted);letter-spacing:.8px}.comparison-values dd{font-size:12px;margin:3px 0 0;font-variant-numeric:tabular-nums}.comparison-values dd strong{color:var(--lime)}
.bars-title{font-size:14px;font-weight:900;margin:30px 0 15px}.bar-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.barbox{padding:16px;background:#21271f;border:1px solid #394537}.barbox h5{font-size:12px;letter-spacing:.8px;margin:0 0 11px}.measure{display:grid;grid-template-columns:72px minmax(0,1fr) 32px;gap:7px;align-items:center;margin:9px 0;font-size:11px}.measure label{min-width:0;overflow-wrap:anywhere}.track{height:10px;background:#353f36;overflow:hidden}.fill{height:100%;transition:width .22s ease}.fill.old{background:var(--lime)}.fill.modern{background:var(--teal)}.measure strong{text-align:right;font-size:11px;font-variant-numeric:tabular-nums}
.distance-anatomy{margin-top:22px;padding-top:18px;border-top:1px solid #3f4a3b}.distance-anatomy .numbers{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.distance-anatomy .numbers div{background:#202b1e;padding:12px}.distance-anatomy strong{font-size:22px;color:var(--teal);font-variant-numeric:tabular-nums;display:block}.distance-anatomy span{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.6px}.distance-anatomy p{color:var(--muted);font-size:11px;margin:12px 0 0}
.weight-card{padding:30px;border:1px solid #52664a;background:linear-gradient(150deg,#202b1e,#171b17);margin:22px 0 45px}.weight-card h3{font-size:27px;letter-spacing:-.8px;margin:7px 0 13px}.weight-card p{font-size:13px;color:var(--muted)}.weight-chart{margin:18px 0 0}.weight-row{display:grid;grid-template-columns:minmax(110px,175px) minmax(40px,1fr) 60px;gap:15px;align-items:center;padding:11px 0;border-top:1px solid #364736}.weight-row span{font-size:13px;font-weight:650}.weight-row .track{height:15px}.weight-row strong{text-align:right;font-size:17px;color:#e1f3df;font-variant-numeric:tabular-nums}.weight-row.shaq strong{color:var(--lime)}.weight-card .note{font-size:11px;margin-top:20px}
.sources{border-top:1px solid var(--line);padding-top:35px;margin:75px 0}.sources h2{font-size:32px;letter-spacing:-1px}.sources p{color:var(--muted);font-size:13px}.sources ul{list-style:none;margin:18px 0;padding:0}.sources li{border-bottom:1px solid var(--line);padding:13px 0}.sources a{font-size:13px;color:var(--ink);font-weight:750}.sources small{display:block;color:var(--muted);font-size:11px;line-height:1.6}
.endcap{padding:70px 35px;border:1px solid #4b6036;background:radial-gradient(circle at 75% 15%,#354726,#182018 58%,#111410);margin:55px 0}.endcap h2{font-size:clamp(38px,5.5vw,63px);line-height:1.05;letter-spacing:-2.6px;max-width:850px;margin:17px 0 19px}.endcap p{font-size:16px;color:#d0d7c7}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:25px}.actions a{font-size:11px;letter-spacing:.9px;text-transform:uppercase;font-weight:850;text-decoration:none;padding:13px 17px;background:var(--lime);color:#12170b;border:1px solid var(--lime)}.actions a.secondary{background:transparent;color:var(--ink);border-color:#64705b}
.footer{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--line);padding:29px 0 65px}.footer p{font-size:12px;color:var(--muted);margin:8px 0}.foot-links{display:flex;gap:19px;font-size:11px;color:var(--muted)}.foot-links a{text-decoration:none}
@media(max-width:990px){.reading-layout{gap:38px;grid-template-columns:minmax(0,1fr) 180px}.hero h1{font-size:57px}.hero{min-height:580px}.hero-image img{min-height:580px}.hero-copy{padding:55px 20px 60px 0}}
@media(max-width:740px){.wrap{width:min(100% - 32px,1160px)}.nav{gap:11px;font-size:10px}.top{height:71px}.hero{grid-template-columns:1fr}.hero-copy{padding:44px 0 28px;order:1}.hero-image{order:0;height:330px}.hero-image img{min-height:330px;height:330px;object-position:center 30%}.hero-image:after{background:linear-gradient(0deg,rgba(16,17,15,.4),transparent 55%)}.hero h1{font-size:clamp(43px,10vw,64px);letter-spacing:-2.5px}.hero .dek{font-size:15px}.hero-stats{gap:15px}.hero-stats b{font-size:25px}.reading-layout{grid-template-columns:1fr;padding-top:40px}.aside{display:none}.story-section{margin-bottom:45px}.story-section p{font-size:15px}.wide-section{padding:18px;margin:5px 0 45px}.rank-row{grid-template-columns:45px minmax(0,1fr) 82px;gap:7px;padding:14px 0}.rank-row h3{font-size:16px}.rank-row b{font-size:17px}.rank-row .rank-no{font-size:24px}.lab{padding:15px}.lab-grid{grid-template-columns:1fr}.lab h3{font-size:24px}.radar-svg{max-width:490px;margin:auto}.bar-grid{grid-template-columns:1fr}.distance-anatomy .numbers strong{font-size:18px}.weight-card{padding:17px}.weight-row{grid-template-columns:95px minmax(0,1fr) 50px;gap:8px}.weight-row span{font-size:11px}.weight-row strong{font-size:14px}.endcap{padding:45px 18px}.footer{flex-direction:column}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important}}
</style>
</head>
<body>
<div class="progress" id="read-progress" aria-hidden="true"></div>
<div class="wrap">
<header class="top"><a class="brand" href="/" aria-label="Anticipate home">ANTICIPATE<b>.</b></a><nav class="nav" aria-label="Primary"><a href="/series/nba-time-machine/">Time Machine</a><a href="/#research">Research</a><a href="https://www.instagram.com/anticipate.peak/" target="_blank" rel="noopener noreferrer">Instagram</a></nav></header>
<main>
<section class="hero" aria-labelledby="article-title">
<div class="hero-copy"><div class="hero-badge"><span class="ep-chip">EPISODE 08</span><span class="overline">NBA TIME MACHINE / RESEARCH</span></div>
<h1 id="article-title">We Tried to Find the Next <em>Shaquille O'Neal.</em> The NBA May Not Have One.</h1>
<p class="dek">A 325-pound force met 279 modern NBA players. Joel Embiid was the closest match. But the distance between Shaq and today's centers tells a bigger story.</p>
<div class="hero-stats"><div><b>279</b><span>2025–26 players</span></div><div><b>325 <small>lb</small></b><span>Shaq's listed weight</span></div><div><b>0.9528</b><span>closest match distance</span></div></div>
<div class="overline" style="margin-top:29px">By Divine Osas-Egbe · November 10, 2026 · 1999–00 vs. 2025–26</div>
</div>
<div class="hero-image"><img src={heroImage} alt="Shaquille O'Neal attacking the basket against Indiana during the 2000 NBA Finals" fetchpriority="high" /><a class="image-credit" href="https://www.nba.com/pacers/gallery/remembering-2000-nba-finals" target="_blank" rel="noopener noreferrer">Image: NBA / Indiana Pacers 2000 Finals archive</a></div>
</section>
<nav class="quicknav" aria-label="Article shortcuts"><a href="#the-season">The 2000 season</a><a href="#method">Our model</a><a href="#results">Top five</a><a href="#compare">Comparison lab</a><a href="#weight">The missing 325 lb</a><a href="#verdict">Verdict</a></nav>
<div class="reading-layout"><article class="reading">
<section class="story-section" id="introduction"><h2><span class="section-no">01 / THE PLAYER</span>The kind of dominance basketball doesn't forget</h2>{story.intro.map(p=><p set:html={p}/>)}</section>
<div class="interlude"><span>NBA TIME MACHINE / THE QUESTION</span><p>How do you replace a player who forced an entire league to change the way it defended the paint?</p></div>
<section class="story-section" id="the-season"><h2><span class="section-no">02 / THE REFERENCE SEASON</span>The season that made Shaq unstoppable</h2>{story.season.map(p=><p set:html={p}/>)}</section>
<section class="story-section" id="method"><h2><span class="section-no">03 / THE METHOD</span>Searching for the next Shaq</h2>{story.method.map(p=><p set:html={p}/>)}</section>
</article><aside class="aside"><div class="side-sticky"><div class="eyebrow">ON THIS PAGE</div>{sections.map(s=><a href={"#"+(s.id==="season"?"the-season":s.id==="method"?"method":s.id==="size"?"weight":s.id==="missing"?"limits":s.id)}>{s.number} / {s.heading}</a>)}<div class="side-stat"><strong>67–15</strong><span>1999–00 Los Angeles Lakers record</span></div></div></aside></div>
<section class="wide-section" id="results">
<div class="wide-head"><div><div class="eyebrow">04 / THE RESULT</div><h2>Five matches. One enormous gap.</h2></div><p>From 279 qualified 2025–26 players, the model selects the five smallest overall distances to Shaq's 1999–00 season.</p></div>
<div class="rankings">{matches.map((m,i)=><div class="rank-row"><span class="rank-no">{String(i+1).padStart(2,"0")}</span><div><h3>{m.name}</h3><small>{m.team} / 2025–26</small></div><b>{m.distance.toFixed(4)}</b></div>)}</div>
<p class="ranking-note">Lower distances represent closer measured profiles, not percentage similarities or equal ability. Shaq uses the standard Anticipate model: 70% statistical, 20% physical and 10% broad position matching. Magic Johnson's separate custom model does not apply here.</p>
<div class="lab" id="compare">
<div class="lab-top"><span class="eyebrow">ANTICIPATE / INTERACTIVE COMPARISON LAB</span><span class="overline">SHAQ 1999–00 × 2025–26</span></div>
<h3>Look inside the distance.</h3><p class="lab-description">Select a modern player to compare all seven scored statistical features, listed size, and the individual component distances. Each axis is fixed across selections.</p>
<div class="player-tabs" aria-label="Choose a modern comparison">{matches.map((m,i)=><button type="button" data-player-index={i} aria-pressed={i===0?"true":"false"}>{m.name}</button>)}</div>
<div class="lab-grid">
<div><svg id="stat-radar" class="radar-svg" viewBox="0 0 480 445" role="img" aria-label="Seven-axis statistical radar comparing Shaquille O'Neal and Joel Embiid">{[.25,.5,.75,1].map(f=><polygon class="ring" points={ring(f)}/>)}{axes.map((ax,i)=>{const p=pt(i,axes.length,135);return <line class="spoke" x1="240" y1="220" x2={p.x} y2={p.y}/>;})}<polygon class="shape-shaq" points={polygon(shaq)}/><polygon class="shape-peer" id="peer-radar-shape" points={polygon(matches[0])}/>{axes.map((ax,i)=>{const p=pt(i,axes.length,182);return <text x={p.x} y={p.y}>{ax.label}</text>;})}</svg><div class="legend"><span><i class="dot"></i>Shaq (1999–00)</span><span><i class="dot peer"></i><span id="selected-legend">Joel Embiid</span> (2025–26)</span></div></div>
<div class="detail-panel" aria-live="polite"><div class="overline">SELECTED MATCH</div><h4 id="selected-name">{matches[0].name}</h4><p id="selected-note">{matches[0].note}</p>
<dl id="selected-values" class="comparison-values">{axes.map(ax=><div><dt>{ax.label}</dt><dd><strong>{shaq[ax.key].toFixed(1)}</strong> / {matches[0][ax.key].toFixed(1)}</dd></div>)}</dl>
<p>Pairs read Shaq / modern player. rTS is the player's true-shooting percentage minus their season league average, in percentage points.</p></div></div>
<div class="bars-title">PHYSICAL PROFILE / LISTED MEASUREMENTS</div>
<div class="bar-grid">
<div class="barbox"><h5>HEIGHT / CM</h5><div class="measure"><label>Shaq</label><div class="track"><div class="fill old" style={"width:"+((shaq.height/230)*100).toFixed(1)+"%"}></div></div><strong>{shaq.height}</strong></div><div class="measure"><label id="height-label">{matches[0].name}</label><div class="track"><div id="height-fill" class="fill modern" style={"width:"+((matches[0].height/230)*100).toFixed(1)+"%"}></div></div><strong id="height-val">{matches[0].height}</strong></div></div>
<div class="barbox"><h5>WEIGHT / LB</h5><div class="measure"><label>Shaq</label><div class="track"><div class="fill old" style={"width:"+((shaq.weight/350)*100).toFixed(1)+"%"}></div></div><strong>{shaq.weight}</strong></div><div class="measure"><label id="weight-label">{matches[0].name}</label><div class="track"><div id="weight-fill" class="fill modern" style={"width:"+((matches[0].weight/350)*100).toFixed(1)+"%"}></div></div><strong id="weight-val">{matches[0].weight}</strong></div></div>
</div>
<div class="distance-anatomy"><div class="overline">COMPONENTS OF THE MODEL</div><div class="numbers"><div><strong id="stat-distance">{matches[0].statDistance.toFixed(4)}</strong><span>Statistical distance</span></div><div><strong id="physical-distance">{matches[0].physicalDistance.toFixed(4)}</strong><span>Physical distance</span></div><div><strong id="overall-distance">{matches[0].distance.toFixed(4)}</strong><span>Overall distance</span></div></div><p>Overall = √(0.70 × statistical distance² + 0.20 × physical distance² + 0.10 × position mismatch). All five top matches are listed as centers, so their positional mismatch is 0. Component distances are standardized, not measured in raw stat units.</p></div>
</div></section>
<div class="reading-layout" style="padding-top:0"><article class="reading">
<section class="story-section" id="embiid"><h2><span class="section-no">05 / CLOSEST MATCH · 0.9528</span>First place: Joel Embiid</h2>{story.embiid.map(p=><p set:html={p}/>)}</section>
<section class="story-section" id="clingan"><h2><span class="section-no">06 / SECOND PLACE · 1.3751</span>Second place: Donovan Clingan</h2>{story.clingan.map(p=><p set:html={p}/>)}</section>
<section class="story-section" id="duren"><h2><span class="section-no">07 / THIRD PLACE · 1.4091</span>Third place: Jalen Duren</h2>{story.duren.map(p=><p set:html={p}/>)}</section>
<section class="story-section" id="towns"><h2><span class="section-no">08 / FOURTH PLACE · 1.4267</span>Fourth place: Karl-Anthony Towns</h2>{story.towns.map(p=><p set:html={p}/>)}</section>
<section class="story-section" id="vucevic"><h2><span class="section-no">09 / FIFTH PLACE · 1.4748</span>Fifth place: Nikola Vučević</h2>{story.vucevic.map(p=><p set:html={p}/>)}</section>
</article></div>
<section class="wide-section" id="weight">
<div class="eyebrow">10 / THE PHYSICAL DISCONNECT</div><h2>The missing 325 pounds</h2>
<div class="weight-card"><h3>Nobody in the qualifying modern pool clears 300 pounds.</h3><p>The comparison below uses listed weights from the same 279-player NBA dataset used by the model, with Shaq's 1999–00 historical reference added for context.</p>
<div class="weight-chart">
{[{name:"SHAQUILLE O'NEAL (2000)",weight:325,shaq:true},{name:"Jusuf Nurkić",weight:290},{name:"Nikola Jokić",weight:284},{name:"Zion Williamson",weight:284},{name:"Brook Lopez",weight:282},{name:"Donovan Clingan",weight:280}].map(p=><div class={"weight-row"+(p.shaq?" shaq":"")}><span>{p.name}</span><div class="track"><div class={"fill "+(p.shaq?"old":"modern")} style={"width:"+((p.weight/350)*100).toFixed(1)+"%"}></div></div><strong>{p.weight} lb</strong></div>)}
</div><p class="note">The modern figures represent listed bio measurements for 2025–26 players who played at least 1,000 minutes, not a census of every NBA player or independently measured playing weight.</p></div>
<div class="reading" style="max-width:760px">{story.size.map(p=><p style="font-size:16px;color:#d1d6cd;line-height:1.88" set:html={p}/>)}</div>
</section>
<div class="reading-layout" style="padding-top:0"><article class="reading"><section class="story-section" id="limits"><h2><span class="section-no">11 / THE LIMITS</span>What the numbers can't measure</h2>{story.missing.map(p=><p set:html={p}/>)}</section><div class="highlight-line">A box score can capture what happened. It rarely captures everything a defense was forced to concede before it happened.</div><section class="story-section" id="verdict"><h2><span class="section-no">12 / THE VERDICT</span>The verdict: an impossible comparison?</h2>{story.verdict.map(p=><p set:html={p}/>)}</section></article></div>
<section class="sources" id="sources"><div class="eyebrow">RESEARCH / EVIDENCE</div><h2>Where the numbers come from</h2><p>The original 70/20/10 NBA Time Machine calculation uses modern season inputs from the supplied 279-player dataset. Historical advanced values are researcher-supplied and have not yet been fully independently audited. Scores are exploratory model outputs, not proof of equivalent playing ability. Public historical season and awards claims have been cross-checked against official NBA and Lakers sources.</p><ul>{sources.map(source=><li><a href={source[1]} target="_blank" rel="noopener noreferrer">{source[0]} ↗</a><small>{source[2]}</small></li>)}</ul></section>
<section class="endcap"><div class="eyebrow">ANTICIPATE / NBA TIME MACHINE / EPISODE 08</div><h2>Closest measured match.<br/>Nothing close to the whole Shaq.</h2><p>Joel Embiid wins the model. Does anyone really play like the most physically dominant center of his era?</p><div class="actions"><a href="/series/nba-time-machine/">All episodes</a><a class="secondary" href="/research/magic-johnson-time-machine/">Previous: Magic Johnson</a><a class="secondary" href="https://github.com/mudia-OE/anticipate-nba-time-machine" target="_blank" rel="noopener noreferrer">Model and data</a></div></section>
</main>
<footer class="footer"><div><a class="brand" href="/">ANTICIPATE<b>.</b></a><p>The future leaves clues. Original basketball research.</p></div><nav class="foot-links"><a href="/">Home</a><a href="/series/nba-time-machine/">All episodes</a><a href="#article-title">Back to top</a></nav></footer></div>
<script type="application/json" id="comparison-data" set:html={comparisonData}></script>
<script is:inline>
(function(){
var el=document.getElementById("comparison-data");if(!el)return;var data;try{data=JSON.parse(el.textContent)}catch(e){return;}
var point=function(i,n,r){return{x:240+Math.cos(-Math.PI/2+2*Math.PI*i/n)*r,y:220+Math.sin(-Math.PI/2+2*Math.PI*i/n)*r};};
var shape=function(p){return data.axes.map(function(ax,i){var f=Math.max(0,Math.min(1,(p[ax.key]-ax.min)/(ax.max-ax.min)));var pt=point(i,data.axes.length,135*f);return pt.x.toFixed(1)+","+pt.y.toFixed(1)}).join(" ");};
document.querySelectorAll("[data-player-index]").forEach(function(button){button.addEventListener("click",function(){var p=data.matches[Number(button.getAttribute("data-player-index"))];if(!p)return;document.querySelectorAll("[data-player-index]").forEach(function(btn){btn.setAttribute("aria-pressed",btn===button?"true":"false");});
document.getElementById("peer-radar-shape").setAttribute("points",shape(p));document.getElementById("stat-radar").setAttribute("aria-label","Seven-axis statistical radar comparing Shaquille O'Neal and "+p.name);document.getElementById("selected-name").textContent=p.name;document.getElementById("selected-legend").textContent=p.name;document.getElementById("selected-note").textContent=p.note;
var values=document.getElementById("selected-values");values.textContent="";data.axes.forEach(function(ax){var root=document.createElement("div"),dt=document.createElement("dt"),dd=document.createElement("dd"),strong=document.createElement("strong");dt.textContent=ax.label;strong.textContent=Number(data.shaq[ax.key]).toFixed(1);dd.append(strong,document.createTextNode(" / "+Number(p[ax.key]).toFixed(1)));root.append(dt,dd);values.append(root);});
["height","weight"].forEach(function(dim){var max=dim==="height"?230:350;document.getElementById(dim+"-label").textContent=p.name;document.getElementById(dim+"-fill").style.width=(p[dim]/max*100).toFixed(1)+"%";document.getElementById(dim+"-val").textContent=p[dim];});document.getElementById("stat-distance").textContent=p.statDistance.toFixed(4);document.getElementById("physical-distance").textContent=p.physicalDistance.toFixed(4);document.getElementById("overall-distance").textContent=p.distance.toFixed(4);
});});
var progress=document.getElementById("read-progress");var updateProgress=function(){var body=document.documentElement;var full=body.scrollHeight-body.clientHeight;progress.style.width=(full>0?Math.min(100,window.scrollY/full*100):0).toFixed(2)+"%";};window.addEventListener("scroll",updateProgress,{passive:true});updateProgress();
})();
</script>
</body>
</html>