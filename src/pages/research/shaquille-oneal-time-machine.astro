const pageUrl = "https://anticipate-peak.vercel.app/research/shaquille-oneal-time-machine/";
const heroImage = "https://cdn.nba.com/teams/legacy/www.nba.com/pacers/sites/pacers/files/2000finalsg1_4.jpg";
const title = "We Tried to Find the Next Shaquille O'Neal. The NBA May Not Have One.";
const description = "We compared Shaq's legendary 1999–00 MVP season against 279 modern NBA players. Joel Embiid was closest, but the missing 325 pounds tells a bigger story.";
const story = {"intro":["There are great centers. There are dominant centers. And then there was Shaquille O'Neal.","At seven-foot-one and a listed 325 pounds, Shaq presented an almost impossible combination of size, strength and explosiveness. He could establish position deep in the paint, catch the ball and turn what should have been a contested possession into two points.","The usual solutions didn't work particularly well.","Put one defender on him, and Shaq could overpower him. Send another, and someone else was open. Foul him, and you were accepting a different kind of risk, betting that the most physically imposing player on the floor would struggle at the free-throw line.","What made Shaq extraordinary wasn't simply that he was enormous. It was what he could do with that size.","Now, more than two decades after his most celebrated season, basketball looks very different.","Centers stretch the floor, initiate offense, switch defensively and operate in space. A modern big man can be expected to do things that barely figured into the job description in 2000.","But that raises an interesting question.","<strong>Has the NBA produced another Shaquille O'Neal?</strong>","And if it has, would the numbers even recognize him?"],"season":["The 1999–2000 season was the defining year of Shaq's dominance.","In 79 games for the Los Angeles Lakers, he averaged <strong>29.7 points, 13.6 rebounds, 3.8 assists and 3.0 blocks</strong>, shooting 57.4% from the field.","He led the league in scoring and field-goal percentage.","He finished second in Defensive Player of the Year voting.","And he came within a single first-place vote of becoming the NBA's first unanimous regular-season MVP.","Under Phil Jackson, the Lakers finished <strong>67–15</strong>, the best record in basketball.","But Shaq wasn't finished.","Los Angeles reached the NBA Finals against the Indiana Pacers, where O'Neal averaged an astonishing <strong>38.0 points and 16.7 rebounds</strong> across six games.","The Lakers won the championship, and Shaq collected Finals MVP.","Regular-season MVP. Finals MVP. NBA champion.","All in one season.","That was the version of Shaquille O'Neal we wanted to reconstruct.","Not the legend as remembered through highlight reels, but the actual statistical profile of his greatest championship season."],"method":["For Episode 08 of NBA Time Machine, we compared Shaq's 1999–2000 season with 279 players from the 2025–26 NBA.","Every modern player in our dataset played at least 1,000 minutes.","We examined seven statistical measures: points per 100 possessions, era-relative true shooting, assist percentage, total rebound percentage, usage percentage, steal percentage and block percentage.","We also compared listed height, weight and broad playing position.","For Shaq, we used <strong>Anticipate's original model: 70% statistical production, 20% physical measurements and 10% positional matching.</strong>","Each numerical measurement was standardized against the modern player pool so that differences in points, percentages, height and weight could be combined into one distance.","The lower the distance, the closer the measured profile.","And the first result was fascinating.","Because while one player emerged as a reasonably clear winner, the wider comparison exposed just how difficult Shaq is to reproduce."],"embiid":["If you were looking for a modern center capable of carrying an offense through high-volume scoring, Joel Embiid would be an understandable place to start.","And our model agrees.","Embiid finished first among all 279 players, comfortably ahead of the competition.","The strongest statistical connection is scoring responsibility.","Shaq's historical reference records <strong>38.1 points per 100 possessions</strong>, with a 31.2% usage rate.","Embiid's 2025–26 season produced <strong>41.0 points per 100 possessions</strong>, with 33.5% usage.","That is an extraordinary level of offensive responsibility for two centers separated by more than 25 years of basketball.","But the resemblance begins to weaken when we examine how that production was achieved.","Shaq was listed at 325 pounds.","Embiid? 270.","And while Shaq's offense was defined by deep positioning, overwhelming strength and interior finishing, Embiid can generate offense through face-up possessions, jump shooting and drawing contact away from the basket.","Their efficiency profiles are different, too.","Shaq's historical reference has a true-shooting percentage 5.5 points above his league's average.","Embiid's 2025–26 figure is 2.4 points above his league's average.","Defensively, both contribute rim protection, but Shaq's 5.3% block rate exceeds Embiid's 3.6%.","There is another important qualification.","Embiid played just <strong>38 games and 1,201 minutes</strong> in the modern season we're comparing. He qualifies under our minimum-minute rule, but this is a much smaller sample than Shaq's 79-game MVP campaign.","The model identifies similarities in production. It doesn't establish that their seasons were equivalent in durability, impact or style.","Embiid is our closest match.","But even the winner is far from an exact recreation."],"clingan":["If Embiid represents the scoring side of Shaq, Donovan Clingan illustrates something different.","The physical and defensive resemblance.","At 218 centimetres, Clingan is slightly taller than Shaq's 216-centimetre historical listing.","His 5.5% block rate is almost identical to Shaq's 5.3%.","And his 23.1% rebound rate actually exceeds Shaq's 18.3%.","Those are meaningful overlaps.","But the offensive difference is enormous.","Shaq scored 38.1 points per 100 possessions.","Clingan scored 21.3.","Shaq's usage was 31.2%.","Clingan's was 16.9%.","The comparison captures a fundamental difference between being a productive interior center and functioning as the overwhelming centerpiece of an entire offense.","Clingan can resemble pieces of Shaq's profile without approaching his offensive responsibility.","His second-place finish tells us as much about what the model values as it does about the player himself."],"duren":["Jalen Duren makes perhaps the most interesting case among the young centers.","His appeal isn't merely his position or his size.","It's the combination of efficient interior scoring and rebounding.","In our modern dataset, Duren averages <strong>33.4 points per 100 possessions</strong> with a <strong>20.9% total rebound rate</strong>.","Both figures bring him into relatively familiar territory alongside Shaq's historical profile.","Duren's era-relative true shooting is also exceptional at <strong>+10.7 percentage points</strong>, compared with Shaq's +5.5.","But there is a catch.","Efficiency and dominance are not interchangeable.","A player can be extraordinarily efficient within a smaller offensive role without being asked to create, finish and sustain the volume of possessions carried by an MVP-level offensive engine.","Duren's 23.6% usage remains considerably below Shaq's 31.2%.","And at a listed 250 pounds, he is 75 pounds lighter than the historical Shaq reference.","Duren represents a recognizable part of Shaq's basketball identity: forceful interior production and dominance on the glass.","What he doesn't reproduce is the sheer scale of the physical and offensive burden."],"towns":["Karl-Anthony Towns introduces an almost perfect contradiction.","His measured production puts him relatively close to Shaq.","His style reflects how drastically the center position has changed.","Towns records <strong>32.1 points per 100 possessions</strong>, a <strong>21.4% rebound rate</strong> and <strong>25.9% usage</strong> in our 2025–26 dataset.","Those are meaningful statistical connections.","But Towns is also a perimeter shooting threat, with a 36.8% three-point percentage.","Shaq's entire offensive identity revolved around a different set of problems.","Could you keep him away from the restricted area?","Could you survive his post touches without sending a second defender?","Could you afford to foul him?","Towns can stretch a defense horizontally, forcing big men away from the basket.","Shaq compressed defenses inward, demanding protection around the rim.","Both approaches can create opportunities for teammates.","But they arrive there through almost opposite basketball philosophies.","This is precisely why the NBA Time Machine must distinguish between statistical resemblance and stylistic resemblance."],"vucevic":["Nikola Vučević completes the top five.","At first, his inclusion might seem less exciting than the others.","But his profile helps illustrate the breadth of the model.","His <strong>17.7% assist rate</strong> sits reasonably close to Shaq's 19.3%, and his <strong>15.8% rebounding rate</strong> is closer than those of some more offensively dominant modern players.","However, his scoring volume, efficiency and physical measurements remain meaningfully different.","Vučević scored 25.2 points per 100 possessions in the modern dataset, substantially below Shaq's 38.1.","And like Towns, he operates in a league that regularly asks centers to contribute beyond the paint.","Vučević illustrates how the model can recognize overlapping components of a historical player without suggesting the modern player behaves like him."],"size":["One detail stands out across the entire analysis.","<strong>Not one of the 279 eligible modern players in our dataset is listed at 300 pounds or more.</strong>","The heaviest is Jusuf Nurkić, at 290 pounds.","Shaq's historical reference?","325.","Even the biggest player in our qualifying modern pool is listed 35 pounds lighter.","Now, listed weights are imperfect. They are not reliable measurements of playing weight on a particular night.","And size alone doesn't determine whether a player can dominate.","But this gap is difficult to ignore.","The modern NBA hasn't eliminated physically imposing centers.","It has changed what is expected of them.","Mobility, spacing, defensive versatility and offensive flexibility can matter just as much as an ability to overpower a defender on the low block.","That evolution makes the search for another Shaq especially difficult.","We are not simply searching for another dominant center.","We are searching for a player whose physical advantages helped define an entire offensive system."],"missing":["Our model identifies Joel Embiid as the closest modern match to the 1999–2000 version of Shaquille O'Neal.","That conclusion follows from the selected features and their weights.","But it leaves out something essential.","Consider what happens when a defense changes its entire approach because of one player.","A big man establishes deep position.","The opposing center needs help.","A second defender moves toward the paint.","A shooter becomes open.","The defense has already surrendered an advantage, even before the player with the ball has attempted a shot.","Box scores can capture the eventual points or assists.","They cannot fully capture the concessions forced before the possession unfolds.","Nor can this model measure how much defensive attention a player demands, the physical cost of defending him or the opportunities created simply by his presence near the basket.","Shaq's influence extended beyond his individual statistical line.","And the more closely we examine the modern matches, the clearer that limitation becomes.","Embiid resembles the offensive responsibility.","Clingan resembles parts of the defensive and physical profile.","Duren resembles the efficient interior production.","Towns demonstrates how a modern center can accumulate similar numbers using a fundamentally different offensive approach.","But none of these comparisons captures the entire package."],"verdict":["The model has a clear answer.","<strong>Joel Embiid is the closest statistical and physical match to Shaquille O'Neal's 1999–2000 season.</strong>","But he isn't a replica of Shaq.","And perhaps that's the more interesting finding.","Basketball didn't stop producing exceptional centers after Shaq.","It produced centers who solve different problems.","Some stretch the floor. Some anchor defenses. Some dominate the glass. Others carry an offense through scoring and playmaking.","What we haven't found in this particular 279-player comparison is a player who combines Shaq's historic offensive production with anything approaching his listed physical dimensions.","That doesn't prove another Shaq could never exist.","It shows how unusual the original was.","Because Shaquille O'Neal didn't simply dominate the game he inherited.","He forced opponents to find ways to survive him.","And more than 25 years later, we're still searching for somebody who can do it quite the same way."]};
const shaq = {"name":"Shaquille O'Neal","pts100":38.1,"rts":5.5,"ast":19.3,"trb":18.3,"usage":31.2,"steal":0.6,"block":5.3,"height":216,"weight":325};
const matches = [{"name":"Joel Embiid","team":"Philadelphia 76ers","distance":0.9528,"pts100":41,"rts":2.4,"ast":21.7,"trb":13.3,"usage":33.5,"steal":0.8,"block":3.6,"height":213,"weight":270,"games":38,"minutes":1201,"statDistance":0.7171,"physicalDistance":1.6551,"role":"Center","note":"Closest overall production profile, especially points per 100 and usage, despite a 55-pound listed weight gap."},{"name":"Donovan Clingan","team":"Portland Trail Blazers","distance":1.3751,"pts100":21.3,"rts":2.3,"ast":11.4,"trb":23.1,"usage":16.9,"steal":1,"block":5.5,"height":218,"weight":280,"games":77,"minutes":2094,"statDistance":1.4772,"physicalDistance":1.3482,"role":"Center","note":"Similar shot-blocking and significant rebounding, but nowhere near Shaq's 1999–00 offensive volume."},{"name":"Jalen Duren","team":"Detroit Pistons","distance":1.4091,"pts100":33.4,"rts":10.7,"ast":11,"trb":20.9,"usage":23.6,"steal":1.4,"block":3,"height":208,"weight":250,"games":70,"minutes":1976,"statDistance":1.1282,"physicalDistance":2.3395,"role":"Center","note":"Strong interior efficiency and rebounding, with substantially lower usage and much less listed weight."},{"name":"Karl-Anthony Towns","team":"New York Knicks","distance":1.4267,"pts100":32.1,"rts":3.8,"ast":14.7,"trb":21.4,"usage":25.9,"steal":1.4,"block":1.8,"height":213,"weight":248,"games":75,"minutes":2322,"statDistance":1.1805,"physicalDistance":2.3022,"role":"Center","note":"Comparable scoring and rebounding in a very different, perimeter-oriented offensive system."},{"name":"Nikola Vučević","team":"Two-team season","distance":1.4748,"pts100":25.2,"rts":-0.7,"ast":17.7,"trb":15.8,"usage":21.4,"steal":1,"block":2,"height":206,"weight":265,"games":64,"minutes":1818,"statDistance":1.404,"physicalDistance":1.994,"role":"Center","note":"Assist and rebound rates overlap, but scoring role, efficiency and listed measurements are farther away."}];
const axes = [{"key":"pts100","label":"PTS / 100","min":0,"max":48},{"key":"rts","label":"rTS","min":-7,"max":16},{"key":"ast","label":"AST%","min":0,"max":55},{"key":"trb","label":"TRB%","min":0,"max":29},{"key":"usage","label":"USG%","min":0,"max":45},{"key":"steal","label":"STL%","min":0,"max":5},{"key":"block","label":"BLK%","min":0,"max":12}];
const sources = [["Los Angeles Lakers: Shaquille O'Neal","https://www.nba.com/lakers/history/alumni/shaquille-oneal","1999–00 box scores, awards and 2000 Finals performance"],["NBA: 1999–2000 season review","https://www.nba.com/news/history-season-review-1999-00","67 wins, scoring title, MVP voting and championship"],["Basketball-Reference: Shaquille O'Neal","https://www.basketball-reference.com/players/o/onealsh01.html","1999–00 NBA regular-season statistics"],["Basketball-Reference: 2025–26 advanced stats","https://www.basketball-reference.com/leagues/NBA_2026_advanced.html","Modern rates and qualified-player model inputs"],["Basketball-Reference: 2025–26 per 100 possessions","https://www.basketball-reference.com/leagues/NBA_2026_per_poss.html","Modern points per 100 possessions"],["Anticipate: NBA Time Machine data and methodology","https://github.com/mudia-OE/anticipate-nba-time-machine","279-player input dataset, historical reference values, ranking distances, original scoring formula"]];
const pt=(i,n,r)=>({x:240+Math.cos(-Math.PI/2+Math.PI*2*i/n)*r,y:220+Math.sin(-Math.PI/2+Math.PI*2*i/n)*r});
const polygon=(player)=>axes.map((axis,i)=>{const fraction=Math.max(0,Math.min(1,(player[axis.key]-axis.min)/(axis.max-axis.min)));const p=pt(i,axes.length,135*fraction);return p.x.toFixed(1)+","+p.y.toFixed(1)}).join(" ");
const ring=(f)=>axes.map((axis,i)=>{const p=pt(i,axes.length,135*f);return p.x.toFixed(1)+","+p.y.toFixed(1)}).join(" ");
const comparisonData = JSON.stringify({shaq,matches,axes});
const sec=(id,number,heading)=>({id,number,heading});
const sections=[
sec("introduction","01","The kind of dominance basketball doesn't forget"),
sec("the-season","02","The season that made Shaq unstoppable"),
sec("method","03","Searching for the next Shaq"),
sec("results","04","The five closest matches"),
sec("embiid","05","First place: Joel Embiid"),
sec("clingan","06","Second place: Donovan Clingan"),
sec("duren","07","Third place: Jalen Duren"),
sec("towns","08","Fourth place: Karl-Anthony Towns"),
sec("vucevic","09","Fifth place: Nikola Vučević"),
sec("weight","10","The missing 325 pounds"),
sec("limits","11","What the numbers can't measure"),
sec("verdict","12","The verdict: an impossible comparison?")
];
