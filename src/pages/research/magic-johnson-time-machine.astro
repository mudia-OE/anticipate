:root{--bg:#10110f;--panel:#1c1e19;--panel2:#252821;--ink:#f3f5ed;--muted:#aeb7aa;--line:#393e37;--lime:#d4ff45;--teal:#82d2c3;color-scheme:dark;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}
