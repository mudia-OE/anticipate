const pageUrl="https://anticipate-peak.vercel.app/research/magic-johnson-time-machine/";
const heroImage="https://cdn.nba.com/manage/2017/05/magic-johnson-shoots-1987-finals-archive.jpg";
const title="We Tried to Find the Next Magic Johnson";
const description="We compared Magic Johnson's 1986–87 MVP and championship season to 279 NBA players from 2025–26. Five unexpected matches, one central question: can a model recognize the genius of Showtime?";
const author="Divine Osas-Egbe";
const magic={"name":"Magic Johnson","pts100":31.1,"rts":6.4,"ast":47.2,"trb":9.7,"usage":26.3,"steal":2.2,"block":0.7,"height":206,"weight":215,"position":"Guard"};
const matches=[{"name":"James Harden","team":"Two-team season","dist":0.7591,"pts100":33.3,"rts":2.9,"ast":34.7,"trb":7.9,"usage":28.6,"steal":1.6,"block":1.1,"height":196,"weight":220,"position":"Guard","description":"The model's unexpected winner. Harden combines high-usage creation, scoring efficiency and major playmaking responsibility, but runs a much more deliberate, three-point-heavy offense."},{"name":"Stephon Castle","team":"San Antonio Spurs","dist":0.7904,"pts100":26.7,"rts":-0.6,"ast":34.5,"trb":9.5,"usage":24.9,"steal":1.8,"block":0.8,"height":198,"weight":215,"position":"Guard","description":"A physical guard with a near-match in rebounding rate, body weight and defensive activity. His scoring efficiency and assist load remain far removed from Magic's MVP season."},{"name":"Cade Cunningham","team":"Detroit Pistons","dist":0.7985,"pts100":34.1,"rts":-1.7,"ast":45.2,"trb":9.2,"usage":30.5,"steal":2,"block":2.5,"height":198,"weight":220,"position":"Guard","description":"An especially persuasive playmaking case: his 45.2% assist rate nearly matches Magic's 47.2%. He loses ground on efficiency and shot-blocking differences, despite a strong large-guard style argument."},{"name":"Josh Giddey","team":"Chicago Bulls","dist":0.8591,"pts100":24.9,"rts":-1.9,"ast":41.1,"trb":13.7,"usage":24.4,"steal":1.5,"block":1.4,"height":201,"weight":214,"position":"Guard","description":"The tall pass-first guard comparison. Giddey offers size, transition vision, rebounding and a 41.1% assist share, but doesn't match Magic's scoring and era-relative efficiency."},{"name":"LeBron James","team":"Los Angeles Lakers","dist":0.8631,"pts100":30.8,"rts":1.3,"ast":34.1,"trb":10.7,"usage":27.2,"steal":1.8,"block":1.6,"height":206,"weight":250,"position":"Forward","description":"The strongest broad stylistic comparison for many viewers: jumbo creator, rebounder and transition playmaker. His positional classification and listed weight cost him points in this particular model."}];
const axes=[{"key":"pts100","label":"PTS / 100","min":0,"max":47},{"key":"rts","label":"rTS","min":-6,"max":14},{"key":"ast","label":"AST%","min":0,"max":55},{"key":"trb","label":"TRB%","min":0,"max":23},{"key":"usage","label":"USG%","min":0,"max":43},{"key":"steal","label":"STL%","min":0,"max":5},{"key":"block","label":"BLK%","min":0,"max":6}];
const sections=[{"id":"magic","n":"01","tag":"THE PLAYER","title":"Why Magic Johnson defies the box score","paras":["At 6-foot-9, Magic challenged the basic idea of what a point guard should look like. He saw over defenders, could rebound like a forward, and created passing angles smaller guards simply could not reach. But his size was only part of the story. The Lakers' <strong>Showtime</strong> identity depended on timing, the entire floor in motion, and his refusal to let an opponent organize defensively.","He did not just collect assists. He controlled their context. A pass into a cutting lane after an opponent's missed shot was a different kind of advantage from a stationary pass that left the receiver to create their own bucket. Magic made teammates better by deciding <em>when</em> they should attack, not simply <em>where</em> to receive the ball.","That makes him a difficult player to reproduce through a box score. We can calculate scoring, rebounding and assist rates. We cannot directly quantify the moment Magic turned a defensive stop into a four-on-three, or how often the threat of a pass forced a defender into the wrong space."]},{"id":"season","n":"02","tag":"THE HISTORIC REFERENCE","title":"1986–87: Magic becomes the offense","paras":["By 1986–87, Magic had already won three championships, but the Lakers were asking more of him. Kareem Abdul-Jabbar was nearing 40, and coach Pat Riley wanted Johnson to take on more scoring without giving up his role as the team's organizer. Magic delivered a career-best <strong>23.9 points per game</strong>, while still leading the entire NBA with <strong>12.2 assists</strong>. He added <strong>6.3 rebounds</strong> and <strong>1.7 steals</strong>, played 80 regular-season games and shot 52.2% from the field.","Los Angeles finished <strong>65–17</strong>, best in the league. Magic claimed his <strong>first regular-season MVP</strong>. The Lakers then tore through the Western Conference playoffs with an 11–1 record before meeting Larry Bird's Boston Celtics in the Finals. They won the series <strong>4–2</strong>, and Magic added <strong>Finals MVP</strong> to his season's honors. That single year gives us a near-perfect case study in a superstar who could drive both an elite offense and a championship run.","The signature moment came in Game 4 in Boston. With the Lakers trailing late, Magic used his right hand to arc a running hook shot over the Celtics' front line. The “junior sky hook” was not his most representative basketball action, but it captured the fundamental problem of guarding him: a 6-foot-9 point guard with a different answer for almost every defense.","The historical model row describes that season as <strong>31.1 points per 100 possessions, a 47.2% assist rate, 9.7% total rebound rate and 26.3% usage</strong>. His <strong>+6.4 percentage points</strong> of true shooting above his era's league average is especially important. He was a creator who scored efficiently while manufacturing opportunities for everybody else.","Magic made only eight three-pointers all regular season, on 39 attempts. He operated in a very different shooting economy from 2025–26, which is exactly why raw three-point volume is <strong>not</strong> included in our similarity distance. But the difference in offensive style cannot simply be wished away by excluding it."]},{"id":"methodology","n":"03","tag":"THE MODEL","title":"How to compare a Showtime guard with today's NBA","paras":["We matched Magic's 1986–87 reference season against <strong>279 NBA players from 2025–26</strong>, each with at least 1,000 regular-season minutes. Players traded during the season have one combined statistical row. This is the same Anticipate model used across our NBA Time Machine investigations.","The model looks at seven statistical features: <strong>points per 100 possessions, era-relative true shooting, assist percentage, total rebound percentage, usage percentage, steal percentage and block percentage</strong>. It separately includes listed height and weight, plus a broad positional group. Statistics contribute <strong>70%</strong> of the overall score, physical measurements <strong>20%</strong>, and positional matching <strong>10%</strong>.","Each numerical feature is standardized using the distribution of the same 279 modern players, then the differences are combined into a weighted distance. <strong>Lower is closer.</strong> Distances are not percentage similarities, probabilities or grades of how great someone is. The model is attempting to measure a season-level production profile, not duplicate a human being.","This distinction matters especially here: the model cannot measure transition tempo, no-look passes, speed of decisions, ballhandling deception, leadership, pace of possession, or how an offense changes when one player sees a cut early. Three-point shooting is deliberately omitted because opportunities differed radically between eras. Any style verdict has to acknowledge what these seven numbers leave out.","The historical Magic reference row comes from the Anticipate project dataset; the historical box-score accomplishments have been independently checked against NBA records, while the full historical advanced-rate dataset remains a researcher-supplied input rather than a fully source-audited collection. We use the model as a starting point for investigation, not an oracle."]},{"id":"reveal","n":"04","tag":"THE RESULTS","title":"The first-place match is not the player you expected","paras":["When we ran the 279 modern candidates through the model, the closest measured season belonged to <strong>James Harden</strong>. His distance is <strong>0.7591</strong>. A player associated with step-back threes, isolations and deliberate half-court manipulation takes the top spot for a legendary transition conductor. On the surface, it sounds wrong.","The other names complicate the story in useful ways. <strong>Stephon Castle</strong> ranks second, <strong>Cade Cunningham</strong> third, <strong>Josh Giddey</strong> fourth and <strong>LeBron James</strong> fifth. Some look closer to Magic physically. Others distribute the ball more like him. One shares his reputation as a jumbo creator and devastating transition passer.","The most important lesson begins with a surprise: <strong>closest production profile is not necessarily closest playing style</strong>. But it would also be too easy to throw out the model just because the first name feels counterintuitive. Harden's first-place ranking has actual statistical foundations."]},{"id":"harden","n":"06","tag":"THE MODEL WINNER","title":"Why James Harden wins the numbers","paras":["Harden's 2025–26 season has <strong>33.3 points per 100 possessions</strong>, compared with Magic's 31.1. Both have large offensive responsibilities: Harden's <strong>28.6% usage</strong> is reasonably close to Magic's 26.3%. Harden also creates for teammates at a high rate, recording a <strong>34.7% assist share</strong>. That is significantly below Magic's 47.2%, but still a high number for a scoring guard.","The more subtle part of the comparison is efficiency. Harden's true shooting is <strong>2.9 percentage points above</strong> the 2025–26 league average, while Magic was <strong>6.4 points above</strong> the 1986–87 average in our reference row. Harden is not equally efficient after adjusting for the league environment, but the direction of their scoring production is similar.","His <strong>7.9% rebound share</strong> trails Magic's 9.7%. Harden is also listed at <strong>196 cm</strong>, a full 10 cm below Magic's 206 cm historical reference. A modest gap in listed weight, 220 versus 215 pounds, helps make him more physically compatible than the height difference alone would suggest.","So why does this first-place answer feel so strange? Because the two players create <em>time</em> in opposite ways. Magic accelerated everything. A rebound became a pass, a pass became a sprint, and a sprint became an easy shot. Harden often slows a possession, manipulates the defender's feet and uses the threat of a three-point shot or foul to unlock an advantage. Both can shape a defense around their decisions, but they are not the same kind of conductor.","Harden is the closest measured package of scoring rate, efficiency, usage, guard position and body dimensions under these exact weights. That is a defensible model result. It is <strong>not</strong> a claim that the Harden step-back is the modern version of Showtime."]},{"id":"castle","n":"07","tag":"THE SECOND-PLACE MATCH","title":"Stephon Castle shows what size and rebounding can do","paras":["Stephon Castle finishes only <strong>0.0313 distance points</strong> behind Harden, at <strong>0.7904</strong>. His listed 215-pound weight matches Magic's historical reference exactly, and his <strong>9.5% rebound share</strong> is remarkably close to Magic's 9.7%. He also has a strong young-guard profile, with an <strong>34.5% assist rate</strong> and considerable responsibility for initiating offense.","But his season doesn't recreate Magic's scoring efficiency. Castle's <strong>26.7 points per 100</strong> is below Magic's 31.1, and his <strong>−0.6 percentage-point relative true shooting</strong> is a long way from Magic's +6.4. This is the gap between showing promising pieces of a large, creative guard profile and matching one of the great efficiency-plus-playmaking seasons in NBA history.","Castle's second-place ranking underlines why a model must be read as a whole rather than a collection of handpicked metrics. He has excellent overlap in the physical and rebounding categories, but less overlap in the historical player's signature scoring efficiency."]},{"id":"cade","n":"08","tag":"THE PLAYMAKER","title":"Cade Cunningham comes closest to Magic's passing burden","paras":["Third place is where the most eye-catching single statistic appears. <strong>Cade Cunningham's 45.2% assist rate</strong> is barely below Magic's <strong>47.2%</strong>. In plain English, the share of teammates' made field goals they assist while on the floor is very similar. Few modern large guards are asked to create for so many possessions.","Cade also recorded <strong>34.1 points per 100 possessions</strong>, topping Magic's 31.1, and his <strong>9.2% rebound rate</strong> sits close to Magic's 9.7. His size and patient passing can make a more intuitive basketball comparison than Harden's perimeter-isolation reputation.","Yet the model sees meaningful differences. Cunningham's era-relative true shooting is <strong>−1.7 percentage points</strong>, against Magic's +6.4. His usage is higher, at <strong>30.5% versus 26.3%</strong>, and his <strong>2.5% block rate</strong> is well above Magic's 0.7. These are not moral judgments about either player; they are the sorts of divergences a standardized distance will register.","That is the revealing trade-off. If our question were simply “who has the closest passing responsibility?”, Cade would make a remarkable case. Because the actual question includes scoring efficiency and several other dimensions, he finishes third. He may be closer in one of Magic's defining skills while farther away in his total measured season."]},{"id":"giddey","n":"09","tag":"THE TALL PASSER","title":"Josh Giddey looks more like the familiar picture of Magic","paras":["Josh Giddey ranks fourth at <strong>0.8591</strong>. At <strong>201 cm and 214 pounds</strong>, his listed physical profile is among the closest in the five-player group to Magic's 206 cm and 215 pounds. He can rebound, push the ball after a stop and make advanced passes with the height to see over smaller guards.","Giddey's <strong>41.1% assist share</strong> is closer to Magic's 47.2 than either Harden's or Castle's. His <strong>13.7% rebound share</strong> actually exceeds Magic's 9.7. That combination of size, rebounding and passing is why the stylistic resemblance can be persuasive before you ever look at a score.","Where Giddey loses ground is offensive production: <strong>24.9 points per 100</strong>, compared with Magic's 31.1, and <strong>−1.9 relative true shooting</strong>, compared with Magic's +6.4. Magic in 1987 wasn't just the tall passer of Showtime. He was a high-level, highly efficient scorer who shouldered more of the Lakers' offense than he had in previous seasons.","Giddey offers recognizable fragments of Magic's on-court identity, especially transition playmaking and size. The MVP-season scoring profile is the harder part to recreate."]},{"id":"lebron","n":"10","tag":"THE WILDCARD","title":"LeBron James: the obvious comparison that finishes fifth","paras":["For many fans, LeBron James is the first name that comes to mind when somebody says “6-foot-9 playmaker.” A big player carrying an offense, grabbing rebounds, accelerating in transition and making passes usually reserved for point guards: that description sounds familiar because LeBron has embodied it for two decades.","Our model's fifth-place LeBron season scores <strong>0.8631</strong>, only <strong>0.0040</strong> behind Giddey. His <strong>30.8 points per 100</strong> is exceptionally close to Magic's 31.1. His <strong>10.7% rebound share</strong> sits near Magic's 9.7, and <strong>27.2% usage</strong> almost matches Magic's 26.3. Those similarities are real.","But the specific 2025–26 LeBron reference is <strong>not prime LeBron</strong>, and we cannot silently substitute a different season. At age 41, this is a later-career production snapshot. Its <strong>34.1% assist rate</strong> is well below Magic's 47.2, while its listed <strong>250-pound weight</strong> is much heavier than the 215-pound Magic row. The model also classifies LeBron as a <strong>forward</strong>, imposing a positional mismatch penalty for comparison with Magic's guard classification.","That is one of the strongest illustrations of the project's limitations. LeBron may be a more intuitive career-long archetype match for Magic than almost anyone in modern basketball. Yet our methodology asks a narrower question: which <em>2025–26 season</em> matches Magic's <em>1986–87 season</em> under this fixed rule? It doesn't compare their entire careers or let the eye test retroactively choose another LeBron year."]},{"id":"verdict","n":"11","tag":"THE VERDICT","title":"Magic's closest match depends on what you mean by closest","paras":["The official result is James Harden. The weighted model selects his 2025–26 season as the nearest combination of scoring, creation, efficiency, rebounding, size and guard position to Magic's 1986–87 MVP campaign. That is the question we set out to calculate, and it deserves to be reported even when the name feels surprising.","But the second and third matches prevent the analysis from becoming a one-name answer. Castle shows how size and rebounding can move a player toward the profile. Cunningham nearly replicates Magic's massive assist share. Giddey offers the rebounding and flowing, tall-guard passing image. LeBron offers perhaps the most recognizable overall stylistic lineage, though the season and position rules push him to fifth.","The fundamental missing variable is how Magic created advantages. This model doesn't measure the difference between a pass that starts a fast break and a pass that finishes a deliberate half-court possession. It doesn't measure the pressure exerted by a point guard who is always looking to run, or how often a defender moves out of position because of an imagined no-look pass.","For our purposes, <strong>Harden is the statistical answer. Cade and Giddey strengthen the playmaking and size cases. LeBron strengthens the stylistic argument.</strong> None of those is a claim that Magic's 1987 season could be transported into 2026 unchanged.","Magic Johnson was not simply the man who led the NBA in assists. In 1986–87, he scored more, remained extraordinarily efficient, and drove a 65-win team to a championship. A player who can make teammates better while still carrying the responsibility of a superstar scorer is difficult to reproduce. A player who can make a whole basketball game move at his chosen speed is harder still."]}];
const sources=[["NBA: 1986–87 season review","https://www.nba.com/news/history-season-review-1986-87","Magic's first MVP, 65-win Lakers season, Finals MVP, 12.2 assists and championship recap."],["NBA Lakers: Magic Johnson alumni statistics","https://www.nba.com/lakers/history/alumni/earvin-magic-johnson","1986–87 regular-season box score and career statistics."],["NBA: History of Magic Johnson","https://www.nba.com/news/history-nba-legend-magic-johnson","Career background, Showtime offense and achievements."],["NBA: Best clutch moments, Magic's junior sky hook","https://www.nba.com/watch/list/collection/best-clutch-moments","1987 Finals fourth-game hook shot in Boston."],["Basketball-Reference: Magic Johnson","https://www.basketball-reference.com/players/j/johnsma02.html","Season-specific box scores, postseason stats and advanced measures."],["Basketball-Reference: 1986–87 per-100 possessions","https://www.basketball-reference.com/leagues/NBA_1987_per_poss.html","Historical possession-normalized scoring."],["Basketball-Reference: 2025–26 advanced stats","https://www.basketball-reference.com/leagues/NBA_2026_advanced.html","2025–26 assists, rebounding, usage and efficiency."],["Basketball-Reference: 2025–26 per-100 possessions","https://www.basketball-reference.com/leagues/NBA_2026_per_poss.html","Modern scoring normalization."],["Anticipate: NBA Time Machine research repository","https://github.com/mudia-OE/anticipate-nba-time-machine","279-player dataset, historic model input, methods and ranked distances."]];
const point=(i,n,d)=>({x:240+Math.cos(-Math.PI/2+2*Math.PI*i/n)*d,y:211+Math.sin(-Math.PI/2+2*Math.PI*i/n)*d});
const polygon=p=>axes.map((a,i)=>{const f=Math.max(0,Math.min(1,(p[a.key]-a.min)/(a.max-a.min)));const q=point(i,axes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
const ring=f=>axes.map((a,i)=>{const q=point(i,axes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
// The position spoke is categorical: 1 = same broad position group as Magic,
// 0 = different group. Height/weight remain measured values on fixed display scales.
const physicalAxes=[
  {key:"height",label:"HEIGHT",min:175,max:220},
  {key:"weight",label:"WEIGHT",min:170,max:270},
  {key:"position",label:"POSITION",min:0,max:1}
];
const physicalPolygon=p=>physicalAxes.map((a,i)=>{const val=a.key==="position"?(p.position===magic.position?1:0):p[a.key];const f=Math.max(0,Math.min(1,(val-a.min)/(a.max-a.min)));const q=point(i,physicalAxes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
const physicalRing=f=>physicalAxes.map((a,i)=>{const q=point(i,physicalAxes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
const labData=JSON.stringify({magic,matches,axes,physicalAxes});
