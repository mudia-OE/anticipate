const pageUrl="https://anticipate-peak.vercel.app/research/magic-johnson-time-machine/";
const heroImage="https://cdn.nba.com/manage/2017/05/magic-johnson-shoots-1987-finals-archive.jpg";
const title="We Tried to Find the Next Magic Johnson";
const description="We compared Magic Johnson's 1986–87 MVP and championship season to 279 NBA players from 2025–26. Five unexpected matches, one central question: can a model recognize the genius of Showtime?";
const author="Divine Osas-Egbe";
const magic={"name":"Magic Johnson","pts100":31.1,"rts":6.4,"ast":47.2,"trb":9.7,"usage":26.3,"steal":2.2,"block":0.7,"height":206,"weight":215};
const matches=[{"name":"James Harden","team":"Two-team season","dist":0.8116,"pts100":33.3,"rts":2.9,"ast":34.7,"trb":7.9,"usage":28.6,"steal":1.6,"block":1.1,"height":196,"weight":220,"description":"The model's unexpected winner. Harden combines high-usage creation, scoring efficiency and major playmaking responsibility, but runs a much more deliberate, three-point-heavy offense."},{"name":"Stephon Castle","team":"San Antonio Spurs","dist":0.8222,"pts100":26.7,"rts":-0.6,"ast":34.5,"trb":9.5,"usage":24.9,"steal":1.8,"block":0.8,"height":198,"weight":215,"description":"A physical guard with a near-match in rebounding rate, body weight and defensive activity. His scoring efficiency and assist load remain far removed from Magic's MVP season."},{"name":"Cade Cunningham","team":"Detroit Pistons","dist":0.8314,"pts100":34.1,"rts":-1.7,"ast":45.2,"trb":9.2,"usage":30.5,"steal":2,"block":2.5,"height":198,"weight":220,"description":"An especially persuasive playmaking case: his 45.2% assist rate nearly matches Magic's 47.2%. He loses ground on efficiency and shot-blocking differences, despite a strong large-guard style argument."},{"name":"Jalen Johnson","team":"Atlanta Hawks","dist":0.8635,"pts100":30.2,"rts":0,"ast":33.5,"trb":15.9,"usage":27,"steal":1.7,"block":1.1,"height":203,"weight":219,"description":"The strong size match: at 203 cm and 219 pounds, Johnson's body measurements are close to Magic's 206 cm and 215 pounds. Weighting physical variables at 30% moves him up to fourth despite a lower assist share."},{"name":"LeBron James","team":"Los Angeles Lakers","dist":0.8677,"pts100":30.8,"rts":1.3,"ast":34.1,"trb":10.7,"usage":27.2,"steal":1.8,"block":1.6,"height":206,"weight":250,"description":"A clear jumbo-creator parallel. Scoring, rebounding and usage resemble Magic's, but a 250-pound listed frame and lower assist share leave LeBron fifth with the model weighted 70/30."}];
const axes=[{"key":"pts100","label":"PTS / 100","min":0,"max":47},{"key":"rts","label":"rTS","min":-6,"max":14},{"key":"ast","label":"AST%","min":0,"max":55},{"key":"trb","label":"TRB%","min":0,"max":23},{"key":"usage","label":"USG%","min":0,"max":43},{"key":"steal","label":"STL%","min":0,"max":5},{"key":"block","label":"BLK%","min":0,"max":6}];
const sections=[{"id":"magic","n":"01","tag":"THE PLAYER","title":"Why Magic Johnson defies the box score","paras":["At 6-foot-9, Magic challenged the basic idea of what a point guard should look like. He saw over defenders, could rebound like a forward, and created passing angles smaller guards simply could not reach. But his size was only part of the story. The Lakers' <strong>Showtime</strong> identity depended on timing, the entire floor in motion, and his refusal to let an opponent organize defensively.","He did not just collect assists. He controlled their context. A pass into a cutting lane after an opponent's missed shot was a different kind of advantage from a stationary pass that left the receiver to create their own bucket. Magic made teammates better by deciding <em>when</em> they should attack, not simply <em>where</em> to receive the ball.","That makes him a difficult player to reproduce through a box score. We can calculate scoring, rebounding and assist rates. We cannot directly quantify the moment Magic turned a defensive stop into a four-on-three, or how often the threat of a pass forced a defender into the wrong space."]},{"id":"season","n":"02","tag":"THE HISTORIC REFERENCE","title":"1986–87: Magic becomes the offense","paras":["By 1986–87, Magic had already won three championships, but the Lakers were asking more of him. Kareem Abdul-Jabbar was nearing 40, and coach Pat Riley wanted Johnson to take on more scoring without giving up his role as the team's organizer. Magic delivered a career-best <strong>23.9 points per game</strong>, while still leading the entire NBA with <strong>12.2 assists</strong>. He added <strong>6.3 rebounds</strong> and <strong>1.7 steals</strong>, played 80 regular-season games and shot 52.2% from the field.","Los Angeles finished <strong>65–17</strong>, best in the league. Magic claimed his <strong>first regular-season MVP</strong>. The Lakers then tore through the Western Conference playoffs with an 11–1 record before meeting Larry Bird's Boston Celtics in the Finals. They won the series <strong>4–2</strong>, and Magic added <strong>Finals MVP</strong> to his season's honors. That single year gives us a near-perfect case study in a superstar who could drive both an elite offense and a championship run.","The signature moment came in Game 4 in Boston. With the Lakers trailing late, Magic used his right hand to arc a running hook shot over the Celtics' front line. The “junior sky hook” was not his most representative basketball action, but it captured the fundamental problem of guarding him: a 6-foot-9 point guard with a different answer for almost every defense.","The historical model row describes that season as <strong>31.1 points per 100 possessions, a 47.2% assist rate, 9.7% total rebound rate and 26.3% usage</strong>. His <strong>+6.4 percentage points</strong> of true shooting above his era's league average is especially important. He was a creator who scored efficiently while manufacturing opportunities for everybody else.","Magic made only eight three-pointers all regular season, on 39 attempts. He operated in a very different shooting economy from 2025–26, which is exactly why raw three-point volume is <strong>not</strong> included in our similarity distance. But the difference in offensive style cannot simply be wished away by excluding it."]},{"id":"methodology","n":"03","tag":"THE MODEL","title":"How to compare a Showtime guard with today's NBA","paras":["Magic's 1986–87 season is compared against <strong>279 NBA players from 2025–26</strong>, each with at least 1,000 minutes. Traded players have one combined row. This article uses the current position-free Anticipate NBA Time Machine model (v3).","The model scores seven statistical features: <strong>points per 100 possessions, era-relative true shooting, assist percentage, total rebound percentage, usage percentage, steal percentage and block percentage</strong>. It also measures <strong>listed height and weight</strong>. Statistics contribute <strong>70%</strong> and physical measurements <strong>30%</strong>. <strong>Position contributes 0%.</strong>","Each numerical feature is standardized against the 279 modern players. Mean squared standardized differences are calculated separately for statistical and physical inputs. The new formula is <strong>distance = √[(0.70 × statistical squared distance) + (0.30 × physical squared distance)]</strong>. <strong>Lower is closer.</strong> Distances are not similarity percentages or measures of greatness.","Position is excluded because Magic's unusual versatility, and that of modern creators such as LeBron and Jalen Johnson, is poorly described by a rigid Guard/Forward/Center category. Every player is evaluated under exactly the same 70/30 position-free rules.","The model still cannot measure transition timing, creative passes, processing speed or the defenses Magic manipulated. Three-point volume is omitted because opportunities varied substantially between eras. The historical advanced-rate row comes from the researcher-supplied reference dataset and has not been fully independently verified."]},{"id":"reveal","n":"04","tag":"THE RESULTS","title":"The first-place match is not the player you expected","paras":["The revised 70/30 model still chooses <strong>James Harden</strong> as Magic Johnson's closest modern production-and-physical-profile match, at <strong>0.8116</strong>. The contrast in playing style remains striking, but the result follows from our chosen measurable inputs.","<strong>Stephon Castle</strong> follows at <strong>0.8222</strong>, <strong>Cade Cunningham</strong> at <strong>0.8314</strong>, <strong>Jalen Johnson</strong> at <strong>0.8635</strong> and <strong>LeBron James</strong> at <strong>0.8677</strong>. Johnson climbs to fourth, moving ahead of LeBron, when listed height and weight receive 30% of the score.","Josh Giddey is now sixth at <strong>0.8707</strong>, just <strong>0.0030</strong> behind LeBron. The ranking reflects a uniform recalculation of all 279 candidates, not a manual adjustment to any one player's results."]},{"id":"harden","n":"06","tag":"THE MODEL WINNER","title":"Why James Harden wins the numbers","paras":["Harden's 2025–26 season has <strong>33.3 points per 100 possessions</strong>, compared with Magic's 31.1. Both have large offensive responsibilities: Harden's <strong>28.6% usage</strong> is reasonably close to Magic's 26.3%. Harden also creates for teammates at a high rate, recording a <strong>34.7% assist share</strong>. That is significantly below Magic's 47.2%, but still a high number for a scoring guard.","The more subtle part of the comparison is efficiency. Harden's true shooting is <strong>2.9 percentage points above</strong> the 2025–26 league average, while Magic was <strong>6.4 points above</strong> the 1986–87 average in our reference row. Harden is not equally efficient after adjusting for the league environment, but the direction of their scoring production is similar.","His <strong>7.9% rebound share</strong> trails Magic's 9.7%. Harden is also listed at <strong>196 cm</strong>, a full 10 cm below Magic's 206 cm historical reference. A modest gap in listed weight, 220 versus 215 pounds, helps make him more physically compatible than the height difference alone would suggest.","So why does this first-place answer feel so strange? Because the two players create <em>time</em> in opposite ways. Magic accelerated everything. A rebound became a pass, a pass became a sprint, and a sprint became an easy shot. Harden often slows a possession, manipulates the defender's feet and uses the threat of a three-point shot or foul to unlock an advantage. Both can shape a defense around their decisions, but they are not the same kind of conductor.","Harden remains the closest measured combination of scoring, efficiency, usage, rebounding and body dimensions under the 70/30 position-free formula. That is a defensible numerical answer, <strong>not</strong> a claim that a step-back-heavy offense recreates Showtime."]},{"id":"castle","n":"07","tag":"THE SECOND-PLACE MATCH","title":"Stephon Castle shows what size and rebounding can do","paras":["Stephon Castle finishes only <strong>0.0106 distance points</strong> behind Harden at <strong>0.8222</strong>. His listed 215-pound weight matches Magic's historical reference, and his <strong>9.5% rebound share</strong> nearly matches Magic's 9.7%. He also carries considerable creation responsibility, with a <strong>34.5% assist rate</strong>.","But his season doesn't recreate Magic's scoring efficiency. Castle's <strong>26.7 points per 100</strong> is below Magic's 31.1, and his <strong>−0.6 percentage-point relative true shooting</strong> is a long way from Magic's +6.4. This is the gap between showing promising pieces of a large, creative guard profile and matching one of the great efficiency-plus-playmaking seasons in NBA history.","Castle's second-place ranking underlines why a model must be read as a whole rather than a collection of handpicked metrics. He has excellent overlap in the physical and rebounding categories, but less overlap in the historical player's signature scoring efficiency."]},{"id":"cade","n":"08","tag":"THE PLAYMAKER","title":"Cade Cunningham comes closest to Magic's passing burden","paras":["Third place is where the most eye-catching single statistic appears. <strong>Cade Cunningham's 45.2% assist rate</strong> is barely below Magic's <strong>47.2%</strong>. In plain English, the share of teammates' made field goals they assist while on the floor is very similar. Few modern large guards are asked to create for so many possessions.","Cade also recorded <strong>34.1 points per 100 possessions</strong>, topping Magic's 31.1, and his <strong>9.2% rebound rate</strong> sits close to Magic's 9.7. His size and patient passing can make a more intuitive basketball comparison than Harden's perimeter-isolation reputation.","Yet the model sees meaningful differences. Cunningham's era-relative true shooting is <strong>−1.7 percentage points</strong>, against Magic's +6.4. His usage is higher, at <strong>30.5% versus 26.3%</strong>, and his <strong>2.5% block rate</strong> is well above Magic's 0.7. These are not moral judgments about either player; they are the sorts of divergences a standardized distance will register.","That is the revealing trade-off. If our question were simply “who has the closest passing responsibility?”, Cade would make a remarkable case. Because the actual question includes scoring efficiency and several other dimensions, he finishes third. He may be closer in one of Magic's defining skills while farther away in his total measured season."]},{"id":"jalen","n":"09","tag":"THE SIZE MATCH","title":"Jalen Johnson climbs into fourth with the 70/30 model","paras":["Jalen Johnson moves to <strong>fourth at 0.8635</strong> under the 70% statistical and 30% physical weighting. His listed <strong>203 cm and 219 pounds</strong> are strikingly close to Magic's <strong>206 cm and 215 pounds</strong>. That physical fit becomes more influential when the model increases the weight of height and weight.","Johnson also scored <strong>30.2 points per 100 possessions</strong>, close to Magic's 31.1, while their usage rates were <strong>27.0% and 26.3%</strong>. These parallels help explain the outcome, but they are only part of the story.","His <strong>15.9% rebound rate</strong> is higher than Magic's 9.7, while his <strong>33.5% assist share</strong> and <strong>0.0 percentage-point relative true shooting</strong> lag Magic's 47.2% and +6.4. The score measures a complete statistical and physical package, not whether Johnson's passing resembles Showtime.","Johnson edges LeBron by only <strong>0.0042</strong> distance points. The gap is small enough that we should avoid turning the ranking into a firm stylistic verdict."]},{"id":"lebron","n":"10","tag":"THE JUMBO CREATOR","title":"LeBron James remains a close fifth-place match","paras":["For many fans, LeBron James is the first name that comes to mind when somebody says “6-foot-9 playmaker.” A big player carrying an offense, grabbing rebounds, accelerating in transition and passing like a point guard: the comparison has been familiar for two decades.","With physical measurements weighted at 30%, <strong>LeBron finishes fifth at 0.8677</strong>, <strong>0.0042</strong> behind Jalen Johnson and <strong>0.0030</strong> ahead of Josh Giddey. His <strong>30.8 points per 100 possessions</strong> is extremely close to Magic's 31.1. His <strong>10.7% rebound share</strong> and <strong>27.2% usage</strong> are also near Magic's 9.7 and 26.3.","This is a <strong>2025–26 LeBron season</strong>, not a substitute for prime LeBron. His <strong>34.1% assist rate</strong> trails Magic's 47.2, and his listed <strong>250 pounds</strong> is well above Magic's 215-pound reference. Giving physical measurements 30% makes that weight gap matter more.","Position never enters the calculation. LeBron's fifth-place finish reflects differences in the selected statistics and body measurements, not a guard-versus-forward tax or a judgment about either player's career."]},{"id":"verdict","n":"11","tag":"THE VERDICT","title":"Magic's closest match depends on what you mean by closest","paras":["<strong>James Harden remains the measured winner</strong> under the 70% statistical and 30% physical position-free model. His 2025–26 season is the nearest combined statistical-and-size profile to Magic's 1986–87 MVP season among 279 qualified modern players.","Castle stays second, Cade nearly matches Magic's extraordinary assist responsibility, Jalen Johnson rises to fourth with stronger physical similarity, and LeBron moves to fifth while retaining a compelling jumbo-playmaker case. Josh Giddey is sixth, only 0.0030 behind LeBron.","The biggest unmeasured variable is how Magic created advantages. The model cannot distinguish a fast-break pass from a stationary pass that forces a teammate to create their own shot, or measure the effect of his court vision on defenders.","<strong>Harden is the numerical answer; Cade and LeBron strengthen the creation comparisons; Castle and Johnson show why size and rebounding matter.</strong> These results do not imply that any modern player reproduces Magic's entire game.","Magic Johnson did more than lead the league in assists. In 1986–87, he combined efficient scoring with brilliant creation and led a 65-win team to a championship. His control over the speed of a game remains difficult to capture in nine measurements."]}];
const sources=[["NBA: 1986–87 season review","https://www.nba.com/news/history-season-review-1986-87","Magic's first MVP, 65-win Lakers season, Finals MVP, 12.2 assists and championship recap."],["NBA Lakers: Magic Johnson alumni statistics","https://www.nba.com/lakers/history/alumni/earvin-magic-johnson","1986–87 regular-season box score and career statistics."],["NBA: History of Magic Johnson","https://www.nba.com/news/history-nba-legend-magic-johnson","Career background, Showtime offense and achievements."],["NBA: Best clutch moments, Magic's junior sky hook","https://www.nba.com/watch/list/collection/best-clutch-moments","1987 Finals fourth-game hook shot in Boston."],["Basketball-Reference: Magic Johnson","https://www.basketball-reference.com/players/j/johnsma02.html","Season-specific box scores, postseason stats and advanced measures."],["Basketball-Reference: 1986–87 per-100 possessions","https://www.basketball-reference.com/leagues/NBA_1987_per_poss.html","Historical possession-normalized scoring."],["Basketball-Reference: 2025–26 advanced stats","https://www.basketball-reference.com/leagues/NBA_2026_advanced.html","2025–26 assists, rebounding, usage and efficiency."],["Basketball-Reference: 2025–26 per-100 possessions","https://www.basketball-reference.com/leagues/NBA_2026_per_poss.html","Modern scoring normalization."],["Anticipate: NBA Time Machine research repository","https://github.com/mudia-OE/anticipate-nba-time-machine","279-player dataset, historic model input, methods and ranked distances."]];
const point=(i,n,d)=>({x:240+Math.cos(-Math.PI/2+2*Math.PI*i/n)*d,y:211+Math.sin(-Math.PI/2+2*Math.PI*i/n)*d});
const polygon=p=>axes.map((a,i)=>{const f=Math.max(0,Math.min(1,(p[a.key]-a.min)/(a.max-a.min)));const q=point(i,axes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
const ring=f=>axes.map((a,i)=>{const q=point(i,axes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
const labData=JSON.stringify({magic,matches,axes});
