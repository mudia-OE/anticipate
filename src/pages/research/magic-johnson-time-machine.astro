.stats-strip{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:45px}.stats-strip>div{padding:22px 13px 25px;border-right:1px solid var(--line)}.stats-strip>div:first-child{padding-left:0}.stats-strip>div:last-child{border:0}.stats-strip strong{display:block;font-size:clamp(25px,2.7vw,37px);font-weight:900;letter-spacing:-1.8px;line-height:1.15;color:var(--lime)}.stats-strip small{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:1px;margin-top:10px;font-weight:700}
