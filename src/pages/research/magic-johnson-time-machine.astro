.hero{display:grid;grid-template-columns:1.06fr .94fr;gap:36px;align-items:center;padding:65px 0 46px}.hero h1{font-size:clamp(45px,5.8vw,81px);line-height:.97;letter-spacing:-4px;margin:22px 0 27px;font-weight:900;max-width:720px}.hero h1 em{font-style:normal;color:var(--lime)}.dek{font-size:18px;line-height:1.72;color:#c1c8bc;max-width:610px}.byline{display:flex;flex-wrap:wrap;gap:12px 20px;margin:28px 0 0;text-transform:uppercase;font-size:11px;letter-spacing:1px;color:var(--muted)}.byline strong{color:var(--ink)}
.hero-photo{height:492px;margin:0;position:relative;border:1px solid #4d5b44;background:linear-gradient(145deg,#374330,#121713);overflow:hidden}.hero-photo img{height:100%;width:100%;object-fit:cover;object-position:center;display:block;filter:saturate(.89) contrast(1.06)}.hero-photo:after{content:"";position:absolute;inset:38% 0 0;background:linear-gradient(transparent,rgba(10,14,10,.94));pointer-events:none}.hero-photo figcaption{position:absolute;bottom:15px;left:18px;right:18px;z-index:1;font-size:10px;line-height:1.5;color:#e1e5db}.photo-index{position:absolute;top:17px;left:18px;color:var(--ink);background:rgba(15,19,13,.75);padding:8px 12px;font-size:10px;font-weight:800;letter-spacing:1.5px;z-index:2}
