 12px}.physical-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:20px 0}.physical-measure{border:1px solid var(--line);padding:18px;background:#181f1a;min-width:0}.measure-title{color:var(--lime);font-size:13px;font-weight:900;letter-spacing:1px;margin-bottom:15px}.measure-row{display:grid;grid-template-columns:minmax(70px,95px) minmax(50px,1fr) 34px;gap:10px;align-items:center;margin:13px 0;font-size:12px}.measure-row span{overflow-wrap:anywhere}.measure-row strong{font-variant-numeric:tabular-nums;text-align:right}.measure-track{height:11px;background:#353e38;overflow:hidden}.measure-fill{height:100%;transition:width .25s ease}.measure-fill.magic{background:var(--lime)}.measure-fill.peer{background:var(--teal)}@media(max-width:700px){.physical-panels{grid-template-columns:1fr}}.physical-note{font-size:11px!important;color:var(--muted)!important;line-height:1.7!important;margin:12px 0 0!important}
