.story-grid{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:58px;align-items:start}.article{min-width:0}.article h2{font-size:clamp(27px,3vw,40px);line-height:1.16;letter-spacing:-1.3px;font-weight:900;margin:58px 0 22px;scroll-margin-top:30px}.article h2:first-child{margin-top:0}.article h2 .section-index{display:block;margin-bottom:13px}.article h3{font-size:21px;line-height:1.25;margin:30px 0 14px}.article p{font-size:16px;line-height:1.92;color:#d3d9cf}.article .lead{font-size:20px;line-height:1.72;color:var(--ink);font-weight:500}.article strong{color:#f4f6ed}.article a{color:var(--teal)}.article blockquote{margin:30px 0;padding:28px 27px;border-left:4px solid var(--lime);background:var(--panel);font-size:25px;line-height:1.3;font-weight:900;letter-spacing:-.55px}.article blockquote small{display:block;font-size:12px;margin-top:14px;letter-spacing:1px;color:var(--muted);font-weight:600;text-transform:uppercase}
