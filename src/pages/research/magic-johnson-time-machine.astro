<script type="application/json" id="lab-data" set:html={labData}></script>
<script is:inline>
(function(){
const el=document.getElementById("lab-data");if(!el)return;
let data;try{data=JSON.parse(el.textContent)}catch(_e){return}
const polar=(i,n,d)=>({x:240+Math.cos(-Math.PI/2+2*Math.PI*i/n)*d,y:211+Math.sin(-Math.PI/2+2*Math.PI*i/n)*d});
const shape=p=>data.axes.map((a,i)=>{const f=Math.max(0,Math.min(1,(p[a.key]-a.min)/(a.max-a.min)));const q=polar(i,data.axes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
const physicalShape=p=>data.physicalAxes.map((a,i)=>{const val=a.key==="position"?(p.position===data.magic.position?1:0):p[a.key];const f=Math.max(0,Math.min(1,(val-a.min)/(a.max-a.min)));const q=polar(i,data.physicalAxes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
const physicalChart=document.getElementById("physical-radar-svg"),physicalPeer=document.getElementById("physical-peer-polygon"),physicalValues=document.getElementById("physical-values");
const values=document.getElementById("peer-values"),chart=document.querySelector(".radar-svg"),polygon=document.getElementById("peer-polygon");
document.querySelectorAll("[data-player-index]").forEach(b=>b.addEventListener("click",()=>{
const p=data.matches[Number(b.getAttribute("data-player-index"))];if(!p)return;
document.querySelectorAll("[data-player-index]").forEach(x=>x.setAttribute("aria-pressed",x===b?"true":"false"));
polygon.setAttribute("points",shape(p));chart.setAttribute("aria-label","Statistical radar comparing Magic Johnson with "+p.name);
physicalPeer.setAttribute("points",physicalShape(p));physicalChart.setAttribute("aria-label","Physical radar comparing Magic Johnson with "+p.name);
document.getElementById("physical-peer-name").textContent=p.name;document.getElementById("physical-legend-name").textContent=p.name;
physicalValues.textContent="";[{key:"height",label:"HEIGHT",unit:"cm"},{key:"weight",label:"WEIGHT",unit:"lb"},{key:"position",label:"POSITION",unit:""}].forEach(a=>{const d=document.createElement("div"),dt=document.createElement("dt"),dd=document.createElement("dd"),strong=document.createElement("strong");dt.textContent=a.label;strong.textContent=data.magic[a.key]+(a.unit?" "+a.unit:"");const suffix=a.key==="position"?(p.position===data.magic.position?" (match)":" (mismatch)"):"";dd.append(strong,document.createTextNode(" / "+p[a.key]+(a.unit?" "+a.unit:"")+suffix));d.append(dt,dd);physicalValues.append(d);});
document.getElementById("peer-name").textContent=p.name;document.getElementById("legend-name").textContent=p.name;document.getElementById("peer-description").textContent=p.description;
values.textContent="";data.axes.forEach(a=>{const d=document.createElement("div"),dt=document.createElement("dt"),dd=document.createElement("dd"),strong=document.createElement("strong");dt.textContent=a.label;strong.textContent=Number(data.magic[a.key]).toFixed(1);dd.append(strong,document.createTextNode(" / "+Number(p[a.key]).toFixed(1)));d.append(dt,dd);values.append(d);});
}));
})();
</script></body></html>