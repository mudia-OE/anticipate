---
const pageUrl="https://anticipate-peak.vercel.app/research/hakeem-olajuwon-time-machine/";
const heroImage="https://a.espncdn.com/photo/2016/0208/r51844_2501x2490cc.jpg";
const title="We Tried to Find the Next Hakeem Olajuwon";
const description="Who comes closest to Hakeem Olajuwon? We compared his dominant 1992–93 season to 279 modern NBA players, found five intriguing matches and explored what the numbers cannot capture about the Dream Shake.";
const author="Divine Osas-Egbe";
const hakeem={"name":"Hakeem Olajuwon","pts100":33.6,"rts":4.1,"ast":15.8,"trb":18.7,"usage":28.8,"steal":2.4,"block":6.5,"height":213,"weight":255};
const matches=[{"name":"Victor Wembanyama","team":"San Antonio Spurs","distance":0.9857,"pts100":41.2,"rts":4.5,"ast":17.6,"trb":21.2,"usage":32.4,"steal":1.7,"block":9.4,"height":224,"weight":235,"minutes":1866,"description":"The closest all-around measured profile: unusual shot-blocking, rebounding and offensive responsibility. The major differences are his perimeter game, height and seasonal workload."},{"name":"Jaren Jackson Jr.","team":"Two-team season","distance":0.9924,"pts100":30.3,"rts":-0.5,"ast":10.4,"trb":10.1,"usage":26.2,"steal":1.7,"block":4.4,"height":208,"weight":242,"minutes":1454,"description":"A near tie in model distance and a closer physical build than Wembanyama. The enormous gap in rebounding rate and difference in shooting diet make him a partial match."},{"name":"Alperen Şengün","team":"Houston Rockets","distance":1.0672,"pts100":30.5,"rts":-1.2,"ast":28.9,"trb":14.8,"usage":26.6,"steal":1.8,"block":3,"height":211,"weight":243,"minutes":2398,"description":"The compelling post-offense comparison. Touch, pivots, footwork and passing create a stylistic parallel that the model cannot directly measure. Defensively he falls well short of this Hakeem season."},{"name":"Alex Sarr","team":"Washington Wizards","distance":1.0855,"pts100":28.4,"rts":-3.7,"ast":15.9,"trb":14.6,"usage":25.7,"steal":1.4,"block":6.4,"height":213,"weight":205,"minutes":1305,"description":"Nearly identical block and assist percentages, but a meaningful efficiency gap, lower rebounding and a very different listed weight."},{"name":"Jalen Duren","team":"Detroit Pistons","distance":1.0979,"pts100":33.4,"rts":10.7,"ast":11,"trb":20.9,"usage":23.6,"steal":1.4,"block":3,"height":208,"weight":250,"minutes":1976,"description":"A physical, rebounding-heavy center with almost identical per-100 scoring, but less shot blocking and a different offensive role."}];
const axes=[{"key":"pts100","label":"PTS/100","min":0,"max":48},{"key":"rts","label":"rTS","min":-6,"max":14},{"key":"ast","label":"AST%","min":0,"max":42},{"key":"trb","label":"TRB%","min":0,"max":27},{"key":"usage","label":"USG%","min":0,"max":42},{"key":"steal","label":"STL%","min":0,"max":5},{"key":"block","label":"BLK%","min":0,"max":11}];
const sections=[{"id":"origins","num":"01","tag":"THE PLAYER","title":"The center who could make you wrong twice","paras":["Hakeem Olajuwon could take over a game before anybody noticed the first point had been scored. A guard drove, saw a defender arrive from an impossible angle and turned the ball away. Another guard floated a layup, only to find the ball flying back. At the other end, a center crowded the low block, guessed which way Olajuwon would spin and discovered that the guess itself was the mistake.","Hakeem was not just a great shot-blocker who later learned to score. His defense and offense came from some of the same qualities: light feet, balance, quick recovery and extraordinary patience. His offensive repertoire, later known as the <strong>Dream Shake</strong>, was not one move. It was an entire sequence of pivots, head fakes, shoulder feints, spins and sudden counter-moves. He could be facing the basket one second and shooting over the opposite shoulder the next.","Born in Lagos, Nigeria, he grew up playing soccer and took up basketball comparatively late. He became a star at the University of Houston, went first overall in the 1984 NBA Draft and developed into one of the most versatile centers ever. In an era when offenses asked big men to own territory near the basket, he was unusually free-moving, creating angles on both ends of the court.","We are not just searching for a player who can block shots or score from the post. We are asking who can approach the balance of those skills that made Olajuwon feel like two different superstars occupying the same body."]},{"id":"season","num":"02","tag":"THE REFERENCE SEASON","title":"1992–93, the year before the dynasty","paras":["The season we selected is <strong>1992–93</strong>, rather than either of Houston's championship years. Across <strong>all 82 games</strong>, Olajuwon averaged <strong>26.1 points, 13.0 rebounds, 3.5 assists, 1.8 steals and 4.2 blocks</strong> in 39.5 minutes per game. He recorded 342 blocks, leading the league in that category for the third time in his career.","Those 4.2 blocks per night are the figure that announces this investigation. But block totals are only a visible part of the impact. A defender this threatening can force a pass before a shot attempt, change the direction of a drive or make an opponent settle for a worse angle. Our model will capture the blocks; it cannot capture every possession altered by the possibility of one.","The Rockets went <strong>55–27</strong>, winning the Midwest Division after finishing 42–40 the previous season. Olajuwon earned his <strong>first Defensive Player of the Year</strong> award and All-NBA and All-Defensive First Team honors. He was <strong>runner-up to Charles Barkley</strong> in MVP voting. Houston won its opening playoff series against the Clippers and then lost a seven-game Western Conference semifinal to Seattle.","His first NBA championship came <strong>the following season, 1993–94</strong>, when he became the first player to win MVP, Defensive Player of the Year and Finals MVP in the same year. Houston repeated as champions in 1994–95. Those accomplishments explain his legacy, but they should not be confused with what he actually achieved in the 1992–93 season we're measuring.","At the possession level, our historical reference uses <strong>33.6 points per 100 possessions</strong>, <strong>18.7% total rebound share</strong>, <strong>15.8% assist share</strong>, <strong>28.8% usage</strong> and <strong>6.5% block share</strong>. His 57.7% true shooting was roughly <strong>4.1 percentage points better</strong> than the league's 53.6% mark. Those numbers become the model's target."]},{"id":"methodology","num":"03","tag":"THE EXPERIMENT","title":"279 players. Seven measures. One very imperfect question.","paras":["We compared that single historical season to <strong>279 NBA players from 2025–26</strong> who logged at least 1,000 minutes, using the same Anticipate model as our previous NBA Time Machine episodes. We use one combined season for traded players, so a two-team line is counted only once.","Our seven statistical features are points per 100 possessions, true-shooting efficiency <em>relative to the player's own league</em>, assist percentage, total rebound percentage, usage, steal percentage and block percentage. The model also compares listed height and weight and applies a small penalty when players belong to different broad position groups. The default weights are <strong>70% statistical profile, 20% physical measurements and 10% positional group</strong>.","Differences are standardized against the distribution of the 279 modern players and combined into one <strong>distance</strong>. A smaller score means a closer measured profile, <strong>not</strong> a larger percentage of Hakeem, and certainly not a claim that the players are equally good. The model does not observe the Dream Shake, footwork, post-up frequency, defensive positioning or how much attention a player draws.","One more boundary: this is a season-level retrospective comparison, not a forecast. Wembanyama and Hakeem could be impressive in different roles, play fewer or more games, and still come out near each other in the rate statistics. The dataset, <a href=\"https://github.com/mudia-OE/anticipate-nba-time-machine\" target=\"_blank\" rel=\"noopener noreferrer\">R code, input records and top-five distances</a> are publicly inspectable; the feature weights are editorial assumptions, not the result of training against a labeled standard of historic resemblance."]},{"id":"result","num":"04","tag":"THE FIRST REVEAL","title":"Wembanyama first. Jackson almost tied. Şengün third.","paras":["The model's first-place answer is <strong>Victor Wembanyama</strong>, at <strong>0.9857</strong>. It is a headline that makes immediate sense if you are thinking of a defender who makes the paint feel smaller while carrying a substantial scoring load. But the margin is extraordinarily thin. <strong>Jaren Jackson Jr.</strong> finishes at <strong>0.9924</strong>, a difference of only <strong>0.0067</strong> distance points.","Then comes the player who changes the question. <strong>Alperen Şengün</strong> ranks third at 1.0672. His defense cannot reproduce Hakeem's 1993 shot-blocking profile, yet his interior passing, deception, body positioning and pivots make him a more interesting answer to the question: who plays offense in ways that resemble the Dream?","That distinction drives the rest of the investigation. Wembanyama and Jackson tell us who matches more of the <em>measured all-around profile</em>. Şengün tells us which part of Hakeem's offensive game might survive a transition into the modern league. Neither question should silently replace the other."]},{"id":"wemby","num":"06","tag":"THE FIRST-PLACE MATCH","title":"Wembanyama matches the two-way silhouette","paras":["For Wembanyama, the defensive argument is obvious. His 2025–26 <strong>9.4% block rate</strong> exceeds the already extraordinary <strong>6.5%</strong> from Hakeem's 1992–93 historical row. Both seasons involve a center who can threaten shots near the basket without being a conventional stationary rim protector. The model is responding to that unusually large defensive presence, not identifying identical technique.","The other numbers reinforce the result. Wembanyama collected <strong>21.2% of available rebounds</strong>, compared with Olajuwon's 18.7%. Their assist rates are in a similar neighborhood, <strong>17.6% versus 15.8%</strong>. Their era-adjusted true shooting almost matches: Wembanyama <strong>+4.5 points</strong> and Hakeem <strong>+4.1</strong> above their respective league baselines. These are meaningful overlaps in a high-volume, two-way role.","But the offensive resemblance has real limits. Wembanyama scored <strong>41.2 points per 100 possessions</strong> in the modern comparison dataset versus Hakeem's 33.6. He is listed at <strong>224 cm</strong>, 11 cm taller than the historical reference. And his shot creation includes perimeter attempts, shooting over defenders from distance and handling farther from the basket. Hakeem's signature was manufacturing advantages through pivots, counters and short-range touch.","There is also a workload gap the model does not measure. The 2025–26 Wembanyama row covers <strong>64 games and 1,866 minutes</strong>. Hakeem played <strong>82 games and 3,242 minutes</strong>. Rate statistics can compare their production when on the floor, but those minutes are not equivalent measures of full-season value or availability.","The defensible conclusion is not that Wembanyama is Hakeem reborn. It is that <strong>he comes closest to reproducing the shape of a superstar whose offensive load and defensive impact were both extraordinary</strong>."]},{"id":"jaren","num":"07","tag":"THE ALMOST-TIE","title":"Jaren Jackson Jr. is closer than the headline suggests","paras":["Jackson is not a distant runner-up. His model distance is <strong>0.9924</strong>, only 0.0067 behind Wembanyama. In other words, the top two are effectively neck and neck in this scoring system. Even minor changes to inputs or modeling decisions could plausibly alter their order, so we should not pretend that first place is an overwhelming win.","His listed <strong>208 cm and 242 lb</strong> lie closer to the Hakeem reference's <strong>213 cm and 255 lb</strong> than Wembanyama's 224 cm and 235 lb. Jackson also has a serious <strong>4.4% block rate</strong>, and his <strong>30.3 points per 100</strong> and 26.2% usage place him in the neighborhood of an important two-way center role.","The weak point is substantial: <strong>10.1% total rebound share</strong>, versus Hakeem's 18.7%. Rebounding was part of how Hakeem finished defensive possessions, and the model does not erase that gap. Jackson's modern offense also includes a much bigger perimeter component. He is a legitimate defensive-family match, but not a player who recreates Hakeem's complete season.","Jackson's entry also uses a <strong>combined two-team 2025–26 season</strong>. We are comparing one season's aggregate production, not claiming he played the same role in two offensive systems or exclusively for one team."]},{"id":"sengun","num":"08","tag":"THE STYLISTIC COUNTERARGUMENT","title":"Şengün is what the radar cannot see","paras":["If you picture Hakeem catching on the block, reading the defender's feet and creating just enough space to finish, <strong>Alperen Şengün</strong> may be the most entertaining modern comparison in the top five. He operates with deliberate pivots, shoulder fakes, passing reads and an understanding of how to turn a defender's momentum against him. He also happens to play in Houston.","That connection does not make him a replica of the Dream Shake. Hakeem was unusually fluid and quick, and his moves worked within an entirely different offensive environment. Şengün leans more heavily into playmaking. His <strong>28.9% assist percentage</strong> nearly doubles Hakeem's <strong>15.8%</strong>, showing that orchestration is a bigger part of his offensive role.","Some of the production does line up. Şengün scored <strong>30.5 points per 100</strong> to Hakeem's 33.6, and used <strong>26.6% of possessions</strong> against Hakeem's 28.8%. His listed size, <strong>211 cm and 243 lb</strong>, is reasonably close to Hakeem's reference. But there is no getting around the other end. Şengün's <strong>3.0% block rate</strong> is less than half Hakeem's 6.5%. He is not a statistical stand-in for the 1993 Defensive Player of the Year.","This is the reason a third-place result can be important even when the model is working correctly. The model captures the <em>amount</em> of production better than the <em>way</em> it happens. When the question changes from “who has Hakeem's two-way numbers?” to “who reminds me of Hakeem on the low block?”, the answer can change too."]},{"id":"others","num":"09","tag":"THE REMAINING MATCHES","title":"Sarr and Duren offer smaller pieces of the puzzle","paras":["<strong>Alex Sarr</strong> is fourth at <strong>1.0855</strong>. The most striking alignment is his <strong>6.4% block rate</strong>, practically identical to Hakeem's 6.5%. Their assist shares also sit almost exactly together: Sarr at <strong>15.9%</strong>, Hakeem at 15.8%. Those are genuine similarities, but Sarr's scoring efficiency sits 3.7 percentage points below the 2025–26 league average, compared with Hakeem at 4.1 points above his own league. He rebounds less, scores less per 100 possessions and carries a much lighter listed weight.","<strong>Jalen Duren</strong> takes fifth at <strong>1.0979</strong>. His <strong>33.4 points per 100</strong> is almost exactly Hakeem's 33.6; his <strong>20.9% total rebound rate</strong> exceeds Hakeem's 18.7%. That makes the physical interior-scoring argument understandable. But his <strong>3.0% block rate</strong> is less than half Hakeem's 6.5%. His offense also asks him to finish very different kinds of opportunities than the Dream Shake produced.","Duren appeared in our previous Moses Malone investigation too. That is not a data error. These are independent comparisons of seasons, and the same current player can share certain production traits with more than one historical legend. It also illustrates why a ranking should not be mistaken for a unique player identity."]},{"id":"verdict","num":"10","tag":"THE VERDICT","title":"One center can match the numbers. Recreating the Dream is harder.","paras":["The official NBA Time Machine result is <strong>Victor Wembanyama</strong>. Of the 279 eligible modern players in our model, he comes closest to Hakeem Olajuwon's 1992–93 combination of scoring, rebounding, efficiency, defensive activity, size and positional role. That is a meaningful statistical finding, not a coincidence.","But it is equally important to say what we did not find. Jaren Jackson Jr. is virtually tied with Wembanyama in overall distance, though his rebounding difference is severe. Alperen Şengün makes the more interesting offensive-footwork case, while falling far short defensively. Sarr and Duren each preserve different fragments of the 1993 profile. No one combines every feature into a convincing one-for-one reproduction.","And the model is missing important basketball information: contested shots, paint deterrence, timing, footwork, strength of opponent, postseason value and how often a player's moves create an advantage before the final shot is recorded. Hakeem's historic 82-game, high-minute season also cannot be reconstructed through rate statistics alone.","The best way to read this investigation is as two answers in conversation. <strong>Wembanyama is the closest statistical match. Şengün is one of the more compelling offensive-style comparisons.</strong> Hakeem was special because he could combine things that remain scattered across today's very best big men.","Finding a replacement for the Dream is not just about finding the blocks. It's about finding the footwork, the scoring, the rebounding and the defensive imagination in the same player, all season long."]}];
const sources=[["NBA: Hakeem Olajuwon legends profile","https://www.nba.com/news/history-nba-legend-hakeem-olajuwon","Career and historical context, 1993 DPOY and the Dream Shake."],["NBA: Archive 75, Hakeem Olajuwon","https://www.nba.com/news/archive-75-hakeem-olajuwon","Player development, NBA career, footwork and defensive impact."],["NBA: Season review 1992–93","https://www.nba.com/news/history-season-review-1992-93","Awards and 1993 playoffs."],["NBA: Rockets single-season blocks leaders","https://www.nba.com/news/houston-rockets-single-season-blocks-per-game-leaders","4.2 blocks per game and 342 total blocks in 1992–93."],["Basketball-Reference: Hakeem Olajuwon","https://www.basketball-reference.com/players/o/olajuha01.html","Per-game, per-possession and advanced historical figures."],["Basketball-Reference: Houston Rockets 1992–93","https://www.basketball-reference.com/teams/HOU/1993.html","55–27 record, division title, playoffs and team context."],["Basketball-Reference: 1993 MVP voting","https://www.basketball-reference.com/awards/awards_1993.html","Hakeem's second-place MVP result behind Barkley."],["StatMuse: historical league true shooting","https://www.statmuse.com/nba/ask/league-average-true-shooting-percentage-every-year-since-1984","1992–93 league 53.6% true shooting."],["Basketball-Reference: 2025–26 per-100 statistics","https://www.basketball-reference.com/leagues/NBA_2026_per_poss.html","Modern scoring and possession data."],["Basketball-Reference: 2025–26 advanced statistics","https://www.basketball-reference.com/leagues/NBA_2026_advanced.html","Modern rebounding, assist, usage and defensive rates."],["Anticipate: NBA Time Machine code and data","https://github.com/mudia-OE/anticipate-nba-time-machine","Model, 279 qualified players, exact 1992–93 reference row and distance output."]];
const point=(i,n,d)=>({x:240+Math.cos(-Math.PI/2+2*Math.PI*i/n)*d,y:211+Math.sin(-Math.PI/2+2*Math.PI*i/n)*d});
const polygon=p=>axes.map((a,i)=>{const f=Math.max(0,Math.min(1,(p[a.key]-a.min)/(a.max-a.min)));const q=point(i,axes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
const ring=f=>axes.map((a,i)=>{const q=point(i,axes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
const labData=JSON.stringify({hakeem,matches,axes});
