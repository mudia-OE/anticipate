.radar-lab{background:var(--panel);border:1px solid #536044;padding:29px;margin:32px 0}.radar-lab h3{font-size:25px;margin:0 0 9px;line-height:1.2}.radar-lab>p{color:var(--muted);font-size:13px}.compare-buttons{display:flex;flex-wrap:wrap;gap:7px;margin:22px 0 12px}.compare-buttons button{border:1px solid #51594b;background:#232820;color:#d5dacf;padding:10px 13px;font-size:12px;font-weight:800}.compare-buttons button[aria-pressed="true"]{border-color:var(--lime);background:var(--lime);color:#151810}.radar-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,.83fr);gap:14px;align-items:center}.radar-svg{width:100%;height:auto;display:block;overflow:visible}.radar-svg .ring{fill:none;stroke:#525e4f;stroke-width:.75}.radar-svg .spoke{stroke:#475043;stroke-width:1}.radar-svg .label{fill:#cdd8c7;font-size:11px;font-weight:800;letter-spacing:.45px;dominant-baseline:middle;text-anchor:middle}.radar-svg .moses-shape{fill:rgba(212,255,69,.16);stroke:var(--lime);stroke-width:2.8}.radar-svg .peer-shape{fill:rgba(130,210,195,.20);stroke:var(--teal);stroke-width:2.8}.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;margin:8px 0 0}.legend span{display:inline-flex;align-items:center;gap:6px}.legend i{width:10px;height:10px;display:inline-block;background:var(--lime)}.legend i.teal{background:var(--teal)}.radar-side{min-width:0}.radar-side h4{font-size:22px;letter-spacing:-.5px;margin:10px 0;line-height:1.2}.radar-side p{color:#c4d0c5;font-size:13px;line-height:1.75;margin-bottom:16px}.radar-side .note{font-size:11px;color:var(--muted)}.value-list{margin:14px 0}.value-list div{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid var(--line);padding:8px 0;font-size:12px}.value-list dt{color:#b4beae}.value-list dd{margin:0;text-align:right;font-variant-numeric:tabular-nums}.value-list strong{color:var(--lime)}
.tablewrap{overflow-x:auto;border:1px solid var(--line);margin:28px 0 14px}.compare-table{width:100%;border-collapse:collapse;min-width:580px;text-align:left;font-variant-numeric:tabular-nums}.compare-table th,.compare-table td{padding:14px 12px;border-bottom:1px solid var(--line);font-size:12px;white-space:nowrap}.compare-table thead{background:#30362b}.compare-table th{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--lime)}.compare-table tr:last-child td{border:0}.compare-table td:first-child{font-weight:800}
.source-list{padding:0;margin:25px 0;list-style:none;counter-reset:source}.source-list li{display:grid;grid-template-columns:27px 1fr;gap:8px;border-bottom:1px solid var(--line);padding:13px 0;counter-increment:source}.source-list li:before{content:counter(source,decimal-leading-zero);font-size:11px;color:var(--lime);font-weight:900;letter-spacing:.5px}.source-list a{font-weight:800}.source-list small{display:block;color:var(--muted);font-size:12px;line-height:1.7;margin-top:5px}
.endcap{background:linear-gradient(130deg,#26311e,#151a15);border:1px solid #54613e;margin:62px 0 15px;padding:36px}.endcap .eyebrow{margin-bottom:12px}.endcap h2{font-size:clamp(27px,3vw,40px);letter-spacing:-1px;line-height:1.15;margin:0 0 14px}.endcap p{color:#c9d4c0;max-width:760px}.action-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:23px}.cta{display:inline-flex;padding:12px 17px;align-items:center;justify-content:center;background:var(--lime);color:#11140f!important;text-decoration:none;font-weight:900;font-size:12px;letter-spacing:.7px;border:1px solid var(--lime)}.cta.secondary{background:transparent;color:var(--ink)!important;border-color:#818c74}.footer{border-top:1px solid var(--line);margin:60px 0 0;padding:35px 0 65px;display:flex;justify-content:space-between;gap:22px}.footer p{font-size:12px;color:var(--muted);margin-top:10px}.footlinks{display:flex;flex-wrap:wrap;gap:23px;font-size:12px;align-items:flex-start;color:var(--muted)}.footlinks a{text-decoration:none}
@media(max-width:980px){.story-grid{grid-template-columns:minmax(0,1fr);gap:12px}.toc{position:static;order:-1;display:flex;flex-wrap:wrap;gap:5px 14px;border-top:1px solid var(--line);padding-bottom:12px}.toc h3{width:100%}.toc a{border:0;padding:6px 0}.toc .recirc{display:none}}
@media(max-width:700px){.shell{width:min(100% - 32px,580px)}.topbar{height:70px}.logo{font-size:23px}.toplinks{gap:13px;font-size:10px}.toplinks a:last-child{display:none}.hero{grid-template-columns:1fr;padding:44px 0 30px;gap:26px}.hero h1{font-size:clamp(45px,12vw,65px);letter-spacing:-2.8px;margin:18px 0}.dek{font-size:16px}.hero-photo{height:345px}.hero-photo img{height:100%}.stats-strip{grid-template-columns:repeat(3,1fr)}.stats-strip>div{padding:16px 9px!important;border-bottom:1px solid var(--line)}.stats-strip strong{font-size:25px}.stats-strip small{font-size:9px}.story-grid{display:flex;flex-direction:column}.article h2{margin-top:43px}.fullbleed{padding:20px;margin:42px 0}.rank-row{padding:13px;gap:9px;grid-template-columns:25px minmax(0,1fr) 58px}.rank-row h3{font-size:15px}.rank-row p{font-size:9px}.rankno,.distance{font-size:18px}.radar-lab{padding:16px;margin:27px 0}.radar-inner{grid-template-columns:1fr}.radar-side{padding:0 5px}.endcap{padding:22px}.footer{flex-direction:column}.toc a{font-size:10px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
</style><style>
.article .story-p{color:#d2d9cf}.radar-lab .label{font-size:11px}.centered{font-size:12px;color:var(--muted);text-align:center}.details-callout{padding:24px;border-left:3px solid var(--lime);background:#20251d;margin:24px 0}.details-callout strong{color:var(--lime)}.close-results{display:flex;gap:18px;flex-wrap:wrap;margin:25px 0}.close-results>div{flex:1;min-width:150px;padding:19px;border:1px solid var(--line);background:var(--panel)}.close-results strong{font-size:28px;display:block;color:var(--lime);line-height:1.2}.close-results small{font-size:10px;color:var(--muted);letter-spacing:1px}.tablewrap{margin:32px 0}.article h2{scroll-margin-top:30px}
</style></head><body><div class="shell">
<header class="topbar"><a class="logo" href="/" aria-label="Anticipate homepage">ANTICIPATE<b>.</b></a><nav class="toplinks" aria-label="Main navigation"><a href="/#research">Research</a><a href="/series/nba-time-machine/">Time Machine</a><a href="#methodology">Method</a></nav></header>
<main>
<section class="hero" aria-labelledby="article-title">
<div><div class="episode"><b>06</b><span>NBA TIME MACHINE / AN ORIGINAL INVESTIGATION</span></div>
<h1 id="article-title">We tried to find the <em>next Hakeem Olajuwon.</em></h1>
<p class="dek">279 modern NBA players. One legendary Hakeem season. We found five surprising statistical matches, but can any of them really recreate the Dream?</p>
<div class="byline"><span>By <strong>{author}</strong></span><span>November 6, 2026</span><span>Research / 12 min read</span></div></div>
<figure class="hero-photo"><span class="photo-index">HOUSTON / NO. 34</span><img src={heroImage} alt="Hakeem Olajuwon driving toward the basket in a Houston Rockets uniform during the 1990s" loading="eager" fetchpriority="high" />
<figcaption>Hakeem Olajuwon during his Houston Rockets career. Archival photo via <a href="https://www.espn.com/nba/photos/gallery/_/id/14742665/image/1/10-greatest-nba-players-ever" target="_blank" rel="noopener noreferrer">ESPN</a>. This is not specifically a 1992–93 photo. Image rights belong to the original rights holder.</figcaption></figure>
</section>
<section class="stats-strip" aria-label="Hakeem Olajuwon 1992–93 regular-season performance">
<div><strong>26.1</strong><small>Points / game</small></div><div><strong>13.0</strong><small>Rebounds / game</small></div><div><strong>4.2</strong><small>Blocks / game</small></div><div><strong>55–27</strong><small>Houston record</small></div><div><strong>DPOY</strong><small>Defensive player</small></div>
</section>
<div class="story-grid">
<article class="article" aria-label="Hakeem research opening">
{sections.slice(0,4).map(s=><section aria-labelledby={s.id}><h2 id={s.id}><span class="section-index">{s.num} / {s.tag}</span>{s.title}</h2>{s.paras.map((p,i)=><p class={i===0&&s.num==="01"?"lead":"story-p"} set:html={p} />)}</section>)}
</article>
<aside class="toc" aria-label="Article table of contents"><h3>Inside the investigation</h3>
{sections.map(s=><a href={"#"+s.id}>{s.num} — {s.title}</a>)}
<a href="#radar">05 — Interactive matchup lab</a><a href="#sources">Sources / methodology</a>
<div class="recirc">NEXT IN THE SERIES<b>Magic Johnson</b>Episode 07 / 1986–87 / Coming soon</div>
</aside></div>
<section class="fullbleed" aria-label="Five closest modern Hakeem comparisons">
<div class="eyebrow">THE MODEL RESULT / 279 QUALIFIED PLAYERS</div><h2>Five matches. A near tie at the top.</h2>
<p class="intro">70% statistics, 20% physical profile, 10% broad positional group. Smaller model distance means closer measured similarity, not a percentage of talent or greatness.</p>
<div class="ranking-list">{matches.map((p,i)=><div class="rank-row"><div class="rankno">{String(i+1).padStart(2,"0")}</div><div><h3>{p.name}</h3><p>{p.team.toUpperCase()} / CENTER / 2025–26</p></div><div class="distance">{p.distance.toFixed(4)}</div></div>)}</div>
<p class="smallnote" style="margin-top:14px">The gap between first and second is only 0.0067 distance points. The model weights are editorial; do not interpret this narrow ordering as certainty.</p>
</section>
<div class="story-grid"><article class="article">
<h2 id="radar"><span class="section-index">05 / INTERACTIVE MATCHUP LAB</span>See what the numbers are actually matching</h2>
<p>Tap each modern center to overlay their 2025–26 rates against Hakeem's 1992–93 season. All seven axes have fixed scales. The radar shows production and activity, not offensive footwork, positioning or film-based style.</p>
<div class="radar-lab"><div class="eyebrow">ANTICIPATE / COMPARE THE PROFILES</div><h3>Hakeem vs. the modern five</h3>
<p>Lime represents Hakeem. Teal represents the selected current player.</p>
<div class="compare-buttons" aria-label="Choose a modern comparison">{matches.map((p,i)=><button type="button" data-player-index={i} aria-pressed={i===0?"true":"false"}>{p.name}</button>)}</div>
<div class="radar-inner"><div><svg class="radar-svg" viewBox="0 0 480 440" role="img" aria-label="Radar chart comparing Hakeem Olajuwon to Victor Wembanyama">
{[.25,.5,.75,1].map(f=><polygon class="ring" points={ring(f)} />)}
{axes.map((a,i)=>{const q=point(i,axes.length,132);return <line class="spoke" x1="240" y1="211" x2={q.x} y2={q.y}/>;})}
<polygon class="moses-shape" points={polygon(hakeem)} /><polygon class="peer-shape" id="peer-polygon" points={polygon(matches[0])} />
{axes.map((a,i)=>{const q=point(i,axes.length,174);return <text class="label" x={q.x} y={q.y}>{a.label}</text>;})}
</svg>
<div class="legend"><span><i></i>Hakeem (1992–93)</span><span><i class="teal"></i><span id="legend-name">Victor Wembanyama</span> (2025–26)</span></div>
</div><div class="radar-side" aria-live="polite"><div class="eyebrow">SELECTED MATCHUP</div><h4 id="peer-name">Victor Wembanyama</h4><p id="peer-description">{matches[0].description}</p>
<dl class="value-list" id="peer-values">{axes.map(a=><div><dt>{a.label}</dt><dd><strong>{hakeem[a.key].toFixed(1)}</strong> / {matches[0][a.key].toFixed(1)}</dd></div>)}</dl>
<p class="note">Values read Hakeem / selected player. Relative TS is percentage points above or below each season's league average. The combined model also scores height, weight and position.</p>
</div></div></div>
<div class="details-callout"><strong>Why the difference matters:</strong> Hakeem's Dream Shake, footwork, shot deterrence and opponent adjustments do not have direct axes. Use the chart to understand the measurable resemblance, not to prove that two players move the same way.</div>
{sections.slice(4).map(s=><section aria-labelledby={s.id}><h2 id={s.id}><span class="section-index">{s.num} / {s.tag}</span>{s.title}</h2>{s.paras.map(p=><p class="story-p" set:html={p} />)}</section>)}
<h2 id="sources"><span class="section-index">SOURCES / REPRODUCIBILITY</span>Inspect the record, not just the headline</h2>
<p>The historical 1992–93 numbers, awards, team results and true-shooting difference were checked against NBA and statistical records. Modern comparisons use Anticipate's research CSV for the 2025–26 season. The source model notes that its original historical reference rows were supplied by the researcher and had not been fully independently audited. Its weights are editorial, and a statistical distance is not a validated measure of playing-style similarity.</p>
<ul class="source-list">{sources.map(s=><li><div><a href={s[1]} target="_blank" rel="noopener noreferrer">{s[0]}</a><small>{s[2]}</small></div></li>)}</ul>
</article><aside></aside></div>
<section class="endcap"><div class="eyebrow">NBA TIME MACHINE / EPISODE 06</div><h2>Wembanyama wins the numbers. Who gives you the Dream?</h2><p>Explore the five matches, then tell us whether the more meaningful resemblance comes from Hakeem's defensive presence or his offensive footwork.</p><div class="action-row"><a class="cta" href="/series/nba-time-machine/">Explore the series</a><a class="cta secondary" href="/research/moses-malone-time-machine/">Previous: Moses Malone</a><a class="cta secondary" href="https://github.com/mudia-OE/anticipate-nba-time-machine" target="_blank" rel="noopener noreferrer">See the model</a></div></section>
</main><footer class="footer"><div><a class="logo" href="/">ANTICIPATE<b>.</b></a><p>Original basketball research. Statistics in context.</p></div><nav class="footlinks"><a href="/">Home</a><a href="/series/nba-time-machine/">All episodes</a><a href="#article-title">Back to top</a></nav></footer></div>
<script type="application/json" id="lab-data" set:html={labData}></script>
<script is:inline>
(function(){
const elem=document.getElementById("lab-data");if(!elem)return;
let data;try{data=JSON.parse(elem.textContent)}catch(_e){return}
const pt=(i,n,d)=>({x:240+Math.cos(-Math.PI/2+2*Math.PI*i/n)*d,y:211+Math.sin(-Math.PI/2+2*Math.PI*i/n)*d});
const shape=p=>data.axes.map((a,i)=>{const f=Math.max(0,Math.min(1,(p[a.key]-a.min)/(a.max-a.min)));const q=pt(i,data.axes.length,132*f);return q.x.toFixed(1)+","+q.y.toFixed(1)}).join(" ");
const values=document.getElementById("peer-values"),chart=document.querySelector(".radar-svg"),polygon=document.getElementById("peer-polygon");
document.querySelectorAll("[data-player-index]").forEach(button=>button.addEventListener("click",()=>{
const i=Number(button.getAttribute("data-player-index")),p=data.matches[i];if(!p)return;
document.querySelectorAll("[data-player-index]").forEach(b=>b.setAttribute("aria-pressed",b===button?"true":"false"));
polygon.setAttribute("points",shape(p));chart.setAttribute("aria-label","Statistical radar chart comparing Hakeem Olajuwon and "+p.name);
document.getElementById("peer-name").textContent=p.name;document.getElementById("legend-name").textContent=p.name;document.getElementById("peer-description").textContent=p.description;
values.textContent="";data.axes.forEach(a=>{const d=document.createElement("div"),dt=document.createElement("dt"),dd=document.createElement("dd"),v=document.createElement("strong");dt.textContent=a.label;v.textContent=Number(data.hakeem[a.key]).toFixed(1);dd.append(v,document.createTextNode(" / "+Number(p[a.key]).toFixed(1)));d.append(dt,dd);values.append(d);});
}));
})();
</script></body></html>