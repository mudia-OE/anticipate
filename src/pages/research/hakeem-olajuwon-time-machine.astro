.research-unit{background:var(--panel);border:1px solid var(--line);padding:26px;margin:32px 0}.research-unit .smallcaps{display:block;color:var(--teal);margin-bottom:13px}.research-unit p:last-child{margin-bottom:0}.formula{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px!important;line-height:1.7!important;overflow-wrap:anywhere;color:var(--lime)!important}
